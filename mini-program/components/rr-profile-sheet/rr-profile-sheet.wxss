@import "../../app.wxss";

.profile-sheet {
  padding-top: 4px;
}

.profile-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 6px 0 4px;
}

.profile-sheet__avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 100% !important;
  padding: 8px 0 4px;
  background: transparent;
}

.profile-sheet__avatar-wrap {
  position: relative;
  width: 76px;
  height: 76px;
}

.profile-sheet__avatar {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  border: 3px solid #f0e2c4;
  background: #faf5eb;
  box-sizing: border-box;
  display: block;
}

.profile-sheet__cam {
  position: absolute;
  right: -2px;
  bottom: -2px;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #1d1a16;
  border: 2px solid #fffdf8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.profile-sheet__cam image {
  width: 13px;
  height: 13px;
  filter: invert(1);
}

.profile-sheet__avatar-tip {
  font-size: 12px;
  color: #7c6b52;
  font-weight: 500;
}

.profile-sheet__field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.profile-sheet__label {
  font-size: 12px;
  font-weight: 600;
  color: #7b6a4f;
  padding-left: 2px;
}

.profile-sheet__input {
  height: 46px;
  padding: 0 14px;
  border-radius: 14px;
  border: 1px solid #e6dbc8;
  background: #faf5ec;
  color: #241e17;
  font-size: 15px;
  box-sizing: border-box;
}

.profile-sheet__error {
  font-size: 12px;
  color: #b4474e;
  text-align: center;
}

.profile-sheet__submit {
  width: 100% !important;
  min-height: 46px;
  margin-top: 2px;
}

.profile-sheet__note {
  font-size: 11px;
  color: #9b8c76;
  text-align: center;
  line-height: 1.4;
}
