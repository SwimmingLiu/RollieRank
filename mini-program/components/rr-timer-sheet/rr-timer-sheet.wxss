.timer__layer {
  position: fixed;
  inset: 0;
  z-index: 60;
  --timer-gutter: 20px;
  --timer-bottom: max(12px, env(safe-area-inset-bottom));
  --timer-room: calc(94vh - var(--timer-keyboard) - var(--timer-bottom));
  color: #18181b;
}
.timer__shade {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, .40);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}
.timer__sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: var(--timer-keyboard);
  display: flex;
  flex-direction: column;
  max-height: calc(var(--timer-room) + var(--timer-bottom));
  padding: 0 var(--timer-gutter) var(--timer-bottom);
  overflow: hidden;
  background: #fff;
  border: 1px solid #e7e4e1;
  border-width: 1px 0 0;
  border-radius: 24px 24px 0 0;
}
.timer__grab { flex: none; display: flex; justify-content: center; align-items: center; height: 31px; }
.timer__handle { width: 26px; height: 3px; border-radius: 99px; background: #e2dcd5; }
.timer__heading { position: relative; display: flex; flex: none; min-height: 47px; align-items: center; justify-content: space-between; margin-bottom: 9px; }
.timer__heading > text { font-size: 20px; font-weight: 600; }
.timer__close { position: absolute; right: 0; top: 50%; transform: translateY(-50%); display: grid; place-items: center; flex: none; margin: 0 !important; width: 44px !important; height: 44px; }
.timer__close image { width: 18px; height: 18px; opacity: .66; }
.timer__switch { flex: none; display: flex; padding: 3px; border-radius: 12px; background: #eee6d8; margin-bottom: 12px; }
.timer__switch-item { display: flex; align-items: center; justify-content: center; flex: 1; margin: 0; width: 0 !important; height: 38px; border-radius: 9px; color: #78654c; font-size: 13px; }
.timer__switch-item--on { background: #fffdf8; color: #4e3b25; font-weight: 600; }
.timer__breadcrumb { flex: none; display: flex; flex-wrap: wrap; align-items: center; gap: 2px; margin-bottom: 10px; color: #776147; font-size: 12px; }
.timer__breadcrumb button { margin: 0; min-height: 32px; padding: 0 5px; color: #8b6f4a; font-size: 12px; }
.timer__breadcrumb > image { width: 12px; height: 12px; opacity: .45; }
.timer__back { display: grid; place-items: center; width: 34px !important; padding: 0 !important; }
.timer__back image { width: 17px; height: 17px; }
.timer__search { flex: none; display: flex; align-items: center; gap: 10px; height: 44px; margin-bottom: 12px; padding: 0 12px; border: 1px solid #e8ddcb; border-radius: 12px; background: #fffdf8; }
.timer__search image { flex: none; width: 16px; height: 16px; opacity: .57; }
.timer__search input { flex: 1; min-width: 0; height: 42px; font-size: 14px; }
.timer__placeholder { color: #96939a; }
.timer__options, .timer__plan-scroll { width: 100%; min-height: 0; }
.timer__options { max-height: max(44px, calc(var(--timer-room) - 201px)); }
.timer__options--with-path { max-height: max(44px, calc(var(--timer-room) - 244px)); }
.timer__publisher, .timer__collection, .timer__paper-option { display: flex; align-items: center; gap: 11px; width: 100% !important; text-align: left; color: #69543a; }
.timer__publisher { min-height: 66px; margin-bottom: 8px; padding: 10px 12px; border: 1px solid #e8ddcb; border-radius: 14px; background: #fffdf8; }
.timer__publisher:last-child { margin-bottom: 0; }
.timer__publisher-icon { flex: none; width: 28px; height: 28px; border: 2px solid #fff; border-radius: 50%; background: #fffdf8; }
.timer__publisher-label { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; font-size: 14px; font-weight: 600; }
.timer__chevron, .timer__paper-option image { flex: none; width: 17px; height: 17px; opacity: .7; }
.timer__collection, .timer__paper-option { min-height: 52px; padding: 10px 4px; border-bottom: 1px solid #eee3d1; }
.timer__collection { min-height: 60px; }
.timer__paper-option { font-size: 16px; }
.timer__paper-option > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.timer__search-group > text { display: block; margin: 14px 4px 4px; color: #9a7d58; font-size: 14px; }
.timer__notice { padding: 16px 0; text-align: center; color: #7a6b57; font-size: 14px; }
.timer__retry { min-height: 44px; padding: 0 12px; margin: 4px auto 0; color: #6c5433; }
.timer__plan-scroll { max-height: max(44px, calc(var(--timer-room) - 212px)); }
.timer__plan-scroll--allocated { max-height: max(44px, calc(var(--timer-room) - 241px)); }
.timer__plan-content { display: flex; flex-direction: column; gap: 12px; padding-bottom: 5px; }
.timer__selected, .timer__module-toggle, .timer__clock-module { display: flex; align-items: center; gap: 8px; width: 100% !important; text-align: left; }
.timer__selected { min-height: 40px; color: #917655; font-size: 12px; }
.timer__selected > text, .timer__module-toggle > text { flex: 1; min-width: 0; }
.timer__selected image, .timer__module-tools image { flex: none; width: 16px; height: 16px; opacity: .65; }
.timer__limit, .timer__duration { border: 1px solid #e7d8bd; background: #f7edd8; color: #6c5433; }
.timer__limit { display: flex; justify-content: space-between; align-items: center; gap: 10px; border-radius: 16px; padding: 13px 16px; }
.timer__limit > view:first-child { display: flex; flex-direction: column; gap: 4px; font-weight: 600; font-size: 14px; }
.timer__limit > view:first-child > text:last-child { font-size: 11px; font-weight: 400; color: #9b8566; }
.timer__limit-value, .timer__duration-value { display: flex; align-items: baseline; gap: 5px; color: #9a8361; font-size: 12px; }
.timer__display-number { font-family: Fraunces, Georgia, serif; font-weight: 650; line-height: 1.1; color: #6c5433; font-variant-numeric: tabular-nums; }
.timer__limit-value > text:first-child { font-size: 31px; }
.timer__duration { display: flex; flex-direction: column; align-items: center; gap: 6px; border-radius: 18px; padding: 14px 12px 12px; }
.timer__duration--compact { flex-direction: row; justify-content: space-between; padding: 8px 10px; }
.timer__duration-label { font-size: 12px; color: #9a8361; }
.timer__stepper { display: flex; justify-content: center; align-items: center; gap: 12px; }
.timer__step { display: grid; place-items: center; flex: none; width: 34px !important; height: 34px; border: 1px solid #d9c7a6; border-radius: 50%; background: #fffaf0; color: #927147; font-size: 19px; }
.timer__total-input { width: 102px; height: 60px; padding: 0 2px; text-align: right; font-size: 46px; }
.timer__duration--compact .timer__stepper { gap: 5px; }
.timer__duration--compact .timer__total-input { width: 70px; height: 38px; font-size: 30px; }
.timer__module-tools { display: flex; align-items: center; gap: 5px; }
.timer__module-toggle { flex: 1; margin: 0; min-height: 42px; padding: 0 4px; font-size: 13px; color: #897457; }
.timer__module-hint { margin-left: 7px; font-size: 11px; color: #a58f73; }
.timer__flip { transform: rotate(180deg); }
.timer__balance { display: grid; place-items: center; flex: none; margin: 0; width: 44px !important; height: 42px; }
.timer__allocation { margin-top: -8px; }
.timer__module-input { display: grid; grid-template-columns: 34px minmax(0, 1fr) 60px 16px; gap: 8px; align-items: center; min-height: 44px; border-bottom: 1px solid #eee3d1; font-size: 13px; color: #756047; }
.timer__module-input input { height: 34px; padding: 0 6px; text-align: center; border: 1px solid #e7decf; border-radius: 8px; background: #fffdf8; }
.timer__module-input > text:last-child { font-size: 11px; }
.timer__module-grip { display: grid; place-items: center; align-self: stretch; touch-action: none; }
.timer__module-grip image { width: 16px; height: 16px; }
.timer__clock { display: flex; flex-direction: column; align-items: center; padding: 8px 4px 5px; color: #917655; font-size: 12px; }
.timer__clock > text:first-child { font-size: clamp(49px, 15vw, 68px); }
.timer__clock > text + text { margin-top: 6px; }
.timer__active-plan, .timer__paused { color: #7d674a; }
.timer__paused { text-align: center; font-size: 12px; }
.timer__progress { height: 5px; margin-top: 12px; width: 100%; overflow: hidden; border-radius: 20px; background: #efe4d4; }
.timer__progress view { height: 100%; border-radius: 20px; background: #b6864d; }
.timer__clock-module { min-height: 44px; padding: 0 5px; border-bottom: 1px solid #efe4d4; color: #847054; font-size: 13px; }
.timer__clock-module > image { width: 14px; height: 14px; }
.timer__clock-module > text:nth-child(2) { flex: 1; }
.timer__clock-module > text:last-child { color: #9a8361; font-size: 11px; }
.timer__clock-module--active { color: #6c5433; background: #fff9ed; }
.timer__footer { flex: none; padding: 5px 0 6px; }
.timer__allocation-total { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 24px; color: #8d7b61; font-size: 12px; }
.timer__allocation-total image { width: 16px; height: 16px; opacity: .58; }
.timer__mismatch { color: #a4624a; }
.timer__actions { display: flex; align-items: center; gap: 8px; padding-top: 9px; }
.timer__actions button { display: flex; align-items: center; justify-content: center; gap: 6px; flex: 1; width: 0 !important; min-height: 44px; border-radius: 12px; font-size: 14px; }
.timer__actions image { width: 16px; height: 16px; }
.timer__primary { background: #18181b; color: #fffdf8; }
.timer__primary[disabled] { opacity: .42; background: #18181b; color: #fffdf8; }
.timer__secondary { border: 1px solid #e8ddcb; background: #fffdf8; color: #756047; }
@media (max-width: 350px) {
  .timer__layer { --timer-gutter: 16px; }
  .timer__module-input { gap: 5px; }
}
@media (max-height: 650px) {
  .timer__grab { height: 22px; }
  .timer__heading { margin-bottom: 5px; }
  .timer__plan-content { gap: 8px; }
}
