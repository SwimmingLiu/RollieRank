.radar__wrap { position: relative; width: 100%; height: 267px; overflow: hidden; }
.radar { display: block; width: 100%; height: 100%; }
.radar__canvas { position: fixed; left: -9999px; top: 0; width: 350px; height: 267px; pointer-events: none; }
@media (max-width: 350px) { .radar__wrap { height: 250px; } }
