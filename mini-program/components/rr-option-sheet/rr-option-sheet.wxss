.options-layer { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; }
.options-shade { position: absolute; inset: 0; background: rgba(249, 246, 239, .46); -webkit-backdrop-filter: blur(9px); backdrop-filter: blur(9px); transition: opacity .28s cubic-bezier(.32, .72, 0, 1); }
.options-panel { position: relative; width: 100%; padding: 4px 20px calc(18px + env(safe-area-inset-bottom)); border: 1px solid #ebe2d3; border-bottom: 0; border-radius: 24px 24px 0 0; background: #fffdf8; box-shadow: 0 -10px 30px rgba(74, 58, 36, .08); box-sizing: border-box; transition: transform .34s cubic-bezier(.32, .72, 0, 1); will-change: transform; }
.options-panel::after { content: ""; position: absolute; left: -1px; right: -1px; top: 100%; height: 96px; background: #fffdf8; border-left: 1px solid #ebe2d3; border-right: 1px solid #ebe2d3; pointer-events: none; }
.options-layer--dragging .options-panel, .options-layer--dragging .options-shade, .options-layer--dragging .options-scroll { transition: none !important; }
.options-layer--closing .options-panel { transform: translateY(100%) !important; transition: transform .26s cubic-bezier(.32, .72, 0, 1) !important; }
.options-layer--closing .options-shade { opacity: 0 !important; transition: opacity .24s cubic-bezier(.32, .72, 0, 1) !important; }
.options-grabber-zone { display: grid; place-items: center; height: 24px; margin: 0 -20px 6px; touch-action: none; }
.options-grabber { width: 40px; height: 4px; border-radius: 999px; background: #d5cfc5; }
.options-scroll { display: block; width: 100%; transition: height .34s cubic-bezier(.32, .72, 0, 1); }
.options-scroll--measuring { max-height: 48vh; }
.options-content { display: flex; flex-direction: column; }
.options-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100% !important; min-height: 62px; padding: 10px 16px; margin: 0 0 8px; border: 1px solid #e7dfd2; border-radius: 16px; box-sizing: border-box; background: #fffdf8; color: #18181b; text-align: left; font-size: 16px; font-weight: 650; }
.options-row text { min-width: 0; }
.options-row:last-child { margin-bottom: 0; }
.options-row::after { border: 0; }
.options-row--selected { border-color: #d9c8a8; background: #f4e3be; }
.options-row--pressed { opacity: .72; }
.options-row image { flex: none; width: 17px; height: 17px; }
@media (max-width: 350px) { .options-panel { padding-inline: 16px; } }
@media (prefers-reduced-motion: reduce) { .options-scroll { transition: none; } }
scroll-view, view { scrollbar-width: none !important; -ms-overflow-style: none !important; }
::-webkit-scrollbar, ::-webkit-scrollbar-thumb, ::-webkit-scrollbar-track, ::-webkit-scrollbar-corner { display: none !important; width: 0 !important; height: 0 !important; color: transparent !important; background: transparent !important; }
