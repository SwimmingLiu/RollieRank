.options-layer { position: fixed; inset: 0; z-index: 50; display: flex; align-items: flex-end; }
.options-shade { position: absolute; inset: 0; background: rgba(41, 33, 27, .34); }
.options-panel { position: relative; width: 100%; padding: 16px 20px calc(12px + env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; background: #fffdf8; box-sizing: border-box; }
.options-scroll { display: block; width: 100%; transition: height .2s ease; }
.options-scroll--measuring { max-height: 48vh; }
.options-content { display: flex; flex-direction: column; }
.options-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100% !important; min-height: 62px; padding: 10px 16px; margin: 0 0 8px; border: 1px solid #e7dfd2; border-radius: 16px; box-sizing: border-box; background: #fffdf8; color: #18181b; text-align: left; font-size: 16px; font-weight: 650; }
.options-row text { min-width: 0; }
.options-row:last-child { margin-bottom: 0; }
.options-row::after { border: 0; }
.options-row--selected { border-color: #d9c8a8; background: #f4e3be; }
.options-row--pressed { opacity: .72; }
.options-row image { flex: none; width: 17px; height: 17px; }
@media (max-width: 350px) { .options-panel { padding-inline: 16px; } }
@media (prefers-reduced-motion: reduce) { .options-scroll { transition: none; } }
