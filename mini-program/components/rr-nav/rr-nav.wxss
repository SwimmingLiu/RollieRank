.nav { position: sticky; top: 0; z-index: 20; background: #fcf8f1; }
.nav__bar { position: relative; display: flex; align-items: center; justify-content: center; }
.nav__title {
  max-width: calc(100% - 2 * var(--menu-clearance));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -.4px;
}
.nav__bar--action .nav__title {
  --title-width: min(96px, calc(100% - var(--menu-clearance) - 112px));
  position: absolute;
  width: var(--title-width);
  left: min(50%, calc(100% - var(--menu-clearance) - 52px - var(--title-width) / 2));
  transform: translateX(-50%);
  max-width: none;
  text-align: center;
}
.nav__bar--leading .nav__title {
  left: 72px;
  width: auto;
  max-width: calc(100% - var(--menu-clearance) - 122px);
  transform: none;
  font-size: 21px;
  font-weight: 700;
}
.nav__back, .nav__action {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  width: 44px !important;
  height: 44px;
  line-height: 1;
  background: transparent;
  color: #68616a;
  font-size: 13px;
}
.nav__back::after, .nav__action::after { border: 0; }
.nav__back { left: 15px; }
.nav__action { right: var(--menu-clearance); }
.nav__pressed { opacity: .6; }
.nav__back-icon { width: 20px; height: 20px; }
.nav__icon { width: 19px; height: 19px; }
.nav__brand { display: flex; align-items: center; gap: 11px; flex: 1; min-width: 0; padding: 0 var(--menu-clearance) 0 22px; }
.nav__logo { width: 44px !important; height: 44px; flex: none; }
.nav__brand-title { font-size: 23px; font-weight: 750; line-height: 1.3; letter-spacing: -1.1px; white-space: nowrap; }
@media (max-width: 350px) {
  .nav__back { left: 8px; }
  .nav__bar--leading .nav__title { left: 58px; }
  .nav__brand { padding-left: 16px; gap: 9px; }
  .nav__brand-title { font-size: 21px; }
  .nav__logo { width: 38px; height: 38px; }
}
