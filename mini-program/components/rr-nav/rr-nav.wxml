<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav__bar" style="height: {{navHeight}}px;">
    <view wx:if="{{back}}" class="nav__back" bindtap="goBack" hover-class="none">
      <image class="nav__icon" src="/assets/ui/back.svg" mode="aspectFit" />
    </view>
    <text class="nav__title" style="line-height: {{titleHeight}}px;">{{title}}</text>
    <view wx:if="{{actionIcon}}" class="nav__action nav__right" bindtap="onAction" hover-class="none">
      <image class="nav__icon" src="/assets/ui/{{actionIcon}}.svg" mode="aspectFit" />
    </view>
    <text wx:elif="{{action}}" class="nav__action nav__right nav__text" bindtap="onAction">{{action}}</text>
  </view>
</view>
