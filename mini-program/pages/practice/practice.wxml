<view class="screen screen--plain">
  <rr-nav title="录答案" back="{{true}}" />

  <view wx:if="{{loading}}" class="loading">正在打开答题卡…</view>
  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
    <view class="chip" bindtap="load">重新读取</view>
  </view>

  <block wx:else>
    <!-- 卷身份一行，右侧为真实录入进度。 -->
    <view class="practice__head">
      <image wx:if="{{logo}}" class="practice__logo" src="{{asset[logo]}}" mode="aspectFit" />
      <text class="practice__identity ellipsis grow">{{identity}} · {{title}}</text>
      <text class="practice__count">{{answered}} / {{version.questionCount}}</text>
    </view>

    <!-- 板块切换与「待检查」筛选，与设计稿同一行。 -->
    <view class="practice__filters">
      <view class="practice__section" bindtap="openSheet">
        <text>{{activeSectionLabel}}</text>
        <image class="practice__chev" src="{{uiBase}}/chevron-down.svg" mode="aspectFit" />
      </view>
      <view class="practice__toggle {{onlyUncertain ? 'practice__toggle--on' : ''}}" bindtap="toggleOnlyUncertain">
        <image class="practice__toggle-icon" src="{{uiBase}}/filter.svg" mode="aspectFit" />
        <text>待检查</text>
        <view class="practice__box">{{onlyUncertain ? '✓' : ''}}</view>
      </view>
    </view>

    <!-- 当前板块的题号范围；板块名只在上方出现一次。 -->
    <view class="practice__range">
      <text class="practice__range-no">{{rangeLabel}}</text>
      <text class="practice__range-hint">{{answeringHint}}</text>
    </view>

    <view class="practice__list">
      <view wx:for="{{questions}}" wx:key="number" class="practice__row">
        <text class="practice__no">{{item.number}}</text>
        <view class="practice__choices">
          <view wx:for="{{choices}}" wx:for-item="choice" wx:key="*this"
                class="practice__choice {{item.answer === choice ? 'practice__choice--on' : ''}}"
                data-number="{{item.number}}" data-choice="{{choice}}" bindtap="choose">{{choice}}</view>
        </view>
        <view class="practice__mark {{item.marked ? 'practice__mark--on' : ''}}" data-number="{{item.number}}" bindtap="toggleMark">
          <image class="practice__mark-icon" src="{{uiBase}}/mark.svg" mode="aspectFit" />
          <text class="practice__mark-label">存疑</text>
        </view>
      </view>
      <view wx:if="{{!questions.length}}" class="empty">
        <text>{{onlyUncertain ? '还没有存疑题目' : '这个板块没有题目'}}</text>
      </view>
    </view>

    <view class="footer-bar">
      <view class="footer-bar__inner">
        <view class="btn btn--ghost" bindtap="openSheet">
          <image class="btn__icon" src="{{uiBase}}/grid.svg" mode="aspectFit" />
        </view>
        <view class="btn btn--primary {{submitting ? 'btn--disabled' : ''}}" bindtap="submit">
          {{answered < version.questionCount ? '交卷 · 未答 ' + (version.questionCount - answered) : '交卷'}}
        </view>
      </view>
    </view>
  </block>
</view>
