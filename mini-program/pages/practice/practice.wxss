.practice { display: flex; flex-direction: column; height: 100vh; min-height: 0; padding-bottom: 0; overflow: hidden; }
.practice__head { flex: none; padding: 0 22px 10px; border-bottom: 1px solid #f0e9dc; }
.practice__identity { display: flex; align-items: center; gap: 7px; height: 48px; font-size: 11px; color: #79767d; }
.practice__identity image { width: 16px; height: 16px; flex: none; }
.practice__count { margin-left: 5px; white-space: nowrap; font-size: 16px; font-weight: 650; color: #302d26; }
.practice__count text { color: #a0927c; font-size: 11px; font-weight: 450; }
.practice__filters { display: flex; align-items: center; gap: 8px; }
.practice__filter { display: flex; align-items: center; justify-content: flex-start; gap: 5px; padding: 0 6px; min-height: 44px; width: auto !important; color: #79654a; font-size: 12px; }
.practice__filter image { width: 15px; height: 15px; flex: none; opacity: .64; }
.practice__filter--icon { width: 44px !important; justify-content: center; }
.practice__filter--on { color: #a36d52; background: #f3e6d6; border-radius: 9px; }
.practice__progress { height: 3px; background: #eae2d5; border-radius: 2px; overflow: hidden; }
.practice__progress view { height: 100%; background: #ba945e; }
.practice__scroller { flex: 1; min-height: 0; height: 0; }
.practice__list { padding: 6px 16px 20px; }
.practice__list-heading { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 44px; padding: 0 6px; color: #777379; font-size: 12px; }
.practice__list-heading text:last-child { color: #9e9aa1; }
.practice__row { position: relative; display: grid; grid-template-columns: 28px repeat(4, minmax(0, 1fr)) 46px; align-items: center; gap: 5px; min-height: 66px; border-bottom: 1px solid #ece3d4; }
.practice__row--current { background: #fff6f2; border-radius: 12px; }
.practice__row--current:before { content: ""; position: absolute; left: -6px; height: 22px; width: 3px; border-radius: 3px; background: #f27076; }
.practice__row--marked { background: #f8efde55; border-radius: 14px; }
.practice__no { padding-left: 6px; color: #a1a1aa; font-size: 14px; }
.practice__row--current .practice__no { color: #18181b; }
.practice__choice { display: grid; place-items: center; width: 100% !important; height: 44px; border: 1px solid #e7dece; border-radius: 13px; box-shadow: 0 2px 0 #e3d8c4; background: #fff; color: #71717a; font-size: 15px; }
.practice__choice--on { border-color: #292a24; background: #292a24; color: #fffaf0; box-shadow: 0 2px 0 #1e211b; }
.practice__mark { display: grid; place-items: center; min-height: 44px; width: 100% !important; }
.practice__mark image { width: 17px; height: 17px; opacity: .64; }
.practice__mark--on image { opacity: 1; }
.practice__mark--on { border-radius: 11px; background: #f1e3c9; color: #9c6d42; }
.practice__footer { flex: none; display: flex; align-items: center; gap: 12px; padding: 12px 20px calc(16px + env(safe-area-inset-bottom)); }
.practice__submit { min-height: 44px; font-weight: 550; }
.practice__footer .btn--ghost { border-radius: 50%; background: transparent; }
.practice__dialog { padding-top: 18px; background: #fff; }
.practice__dialog .sheet-scroll { max-height: 55vh; }
.practice__skip { border: 1px solid #ded3c1; background: #fffdf8; color: #655947; }
.practice__section-list { display: flex; flex-direction: column; gap: 8px; padding: 4px 0; }
.practice__section-option { display: flex; align-items: center; justify-content: space-between; width: 100% !important; min-height: 44px; padding: 10px 14px; border-radius: 12px; background: #f4ecde; color: #655743; font-size: 14px; }
.practice__section-option image { width: 16px; height: 16px; opacity: .6; }
.practice__sheet-summary { display: flex; align-items: baseline; gap: 4px; padding: 0 2px 9px; color: #81766d; font-size: 12px; }
.practice__sheet-summary > text:nth-child(2) { color: #484039; font-size: 14px; font-weight: 650; }
.practice__sheet-group { margin-bottom: 12px; }
.practice__sheet-group-title { position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 10px 1px 9px; background: #fff; color: #51483f; font-size: 13px; font-weight: 600; }
.practice__sheet-group-title text:last-child { color: #928779; font-size: 11px; font-weight: 450; white-space: nowrap; }
.practice__sheet-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; padding: 0; }
.practice__sheet-cell { position: relative; display: grid; place-items: center; width: 100% !important; min-width: 0; height: auto; aspect-ratio: 1; padding: 10px 0 0; border: 1px solid #ece7e1; border-radius: 13px; color: #493c31; background: #fff; font-size: 18px; }
.practice__sheet-cell--done { background: #f5ecdb; border-color: #eadfc9; }
.practice__sheet-cell--marked::after { content: ""; position: absolute; top: 6px; right: 6px; width: 5px; height: 5px; border-radius: 50%; background: #bc8d58; }
.practice__sheet-cell--current { border: 2px solid #d49a90; box-shadow: 0 0 0 1px #f7e6e1 inset; }
.practice__sheet-number { position: absolute; top: 7px; left: 8px; color: #8c8073; font-size: 11px; line-height: 1.2; font-weight: 500; font-variant-numeric: tabular-nums; }
.practice__sheet-answer { line-height: 1.1; font-weight: 650; }
.practice__sheet-cell:not(.practice__sheet-cell--done) .practice__sheet-answer { color: #d4cec5; font-weight: 400; }
.practice__single { padding: 16px 22px 18px; }
.practice__single-card { width: 100%; min-height: min(430px, calc(100vh - 224px)); padding: 22px 20px 14px; border: 1px solid #e7dcc9; border-radius: 23px; background: #fffdf8; box-shadow: 0 3px 0 #e9dfcf; }
.practice__single-head { position: relative; display: flex; align-items: center; min-height: 44px; padding-right: 48px; margin-bottom: 25px; }
.practice__single-head > .practice__filter { position: absolute; top: 50%; right: 0; transform: translateY(-50%); margin: 0 !important; }
.practice__single-label { color: #9a886e; font-size: 12px; }
.practice__single-number { margin-inline: 3px; color: #514332; font-size: 32px; font-weight: 650; }
.practice__single-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.practice__single-choices .practice__choice { display: flex; align-items: center; justify-content: space-between; padding: 0 19px; height: 78px; border-color: #e9dfcf; border-radius: 15px; background: #fffefb; color: #7c705f; box-shadow: 0 2px 0 #eee5d6; font-size: 25px; font-weight: 550; }
.practice__single-choices .practice__choice--on { border-color: #c4a36f; background: #f4e6c8; color: #6c522e; box-shadow: 0 2px 0 #ddc79f; }
.practice__single-choices image, .practice__single-dot { width: 17px; height: 17px; flex: none; }
.practice__single-dot { border: 1px solid #e4d8c3; border-radius: 50%; }
.practice__single-links { display: flex; justify-content: space-between; margin-top: clamp(20px, 7vh, 54px); padding-top: 8px; border-top: 1px solid #eee5d7; }
.practice__single-links button[disabled] { background: transparent; opacity: .45; }
@media (max-width: 350px) {
  .practice__head, .practice__footer, .practice__single { padding-inline: 16px; }
  .practice__list { padding-inline: 12px; }
  .practice__row { grid-template-columns: 22px repeat(4, minmax(0, 1fr)) 44px; }
  .practice__sheet-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
@media (max-height: 650px) {
  .practice__single { padding-top: 10px; }
  .practice__single-card { min-height: 0; padding: 12px; }
  .practice__single-head { margin-bottom: 12px; }
  .practice__single-choices .practice__choice { height: 62px; padding-inline: 15px; }
  .practice__single-links { margin-top: 10px; }
}
