/* 录答案：卷身份一行、板块切换与待检查筛选、题号范围、紧凑选项行。 */
.practice__head { display: flex; align-items: center; gap: 8px; padding: 6px 20px 0; }
.practice__logo { width: 16px; height: 16px; flex-shrink: 0; }
.practice__identity { font-size: 12px; color: #71717a; }
.practice__count { font-size: 13px; color: #18181b; font-variant-numeric: tabular-nums; margin-left: 10px; }

.practice__filters { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px 8px; }
.practice__section { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; color: #18181b; }
.practice__chev { width: 14px; height: 14px; opacity: 0.6; }
.practice__toggle { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #71717a; }
.practice__toggle--on { color: #c2565c; }
.practice__toggle-icon { width: 15px; height: 15px; opacity: 0.7; }
.practice__box { width: 17px; height: 17px; border: 1px solid #d4d4d8; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #18181b; }
.practice__toggle--on .practice__box { border-color: #18181b; }

.practice__range { display: flex; align-items: center; justify-content: space-between; padding: 2px 20px 8px; border-bottom: 1px solid #e4e4e7; }
.practice__range text { font-size: 12px; color: #71717a; }
.practice__range-hint { opacity: 0.8; }
.practice__range-no { font-variant-numeric: tabular-nums; }

.practice__list { padding: 0 16px 30px; }
.practice__row { display: flex; align-items: center; gap: 10px; padding: 7px 4px; border-bottom: 1px solid #f4f4f5; }
.practice__no { width: 26px; text-align: center; font-size: 13px; color: #71717a; font-variant-numeric: tabular-nums; }
.practice__choices { flex: 1; display: flex; gap: 8px; }
.practice__choice { flex: 1; height: 40px; border-radius: 10px; background: #fffdf8; border: 1px solid #e4e4e7; display: flex; align-items: center; justify-content: center; font-size: 16px; color: #3f3f46; }
.practice__choice--on { background: #18181b; border-color: #18181b; color: #fcf8f1; font-weight: 600; }
.practice__mark { width: 40px; display: flex; flex-direction: column; align-items: center; gap: 1px; color: #b7b1a7; }
.practice__mark-icon { width: 16px; height: 16px; }
.practice__mark-label { font-size: 10px; line-height: 1.2; }
.practice__mark--on { color: #c2565c; }
