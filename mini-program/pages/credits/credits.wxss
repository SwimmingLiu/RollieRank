.credits__scroll-body {
  padding-bottom: calc(96px + env(safe-area-inset-bottom));
}

.credits {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 14px 22px 24px;
}

.credits__loading {
  padding: 64px 0;
  text-align: center;
  color: var(--quiet);
  font-size: 13px;
}

/* 顶部暖米余额画报卡（与首页/个人中心封面卡同源视觉） */
.credits__hero {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 18px 18px 14px;
  border: 1px solid #e3d3b1;
  border-radius: 22px;
  background: #f0e2c4;
  box-shadow: 0 3px 0 #e5d5b3;
}

.credits__hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.credits__hero-copy {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.credits__hero-art {
  width: 82px;
  height: 82px;
  flex: none;
  margin-right: -2px;
}

.credits__eyebrow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  font-size: 13px;
  font-weight: 600;
  color: #6b5839;
}

.credits__eyebrow-icon {
  width: 21px;
  height: 21px;
  flex: none;
}

.credits__pill {
  display: inline-flex;
  align-items: center;
  height: 22px;
  padding: 0 9px;
  border-radius: 999px;
  background: rgba(255, 253, 248, 0.85);
  border: 1px solid rgba(215, 196, 160, 0.7);
  color: #5e4b2e;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}

.credits__pill--coral {
  background: var(--coral-soft);
  border-color: #f3cbc7;
  color: #b4474e;
}

.credits__pill--ochre {
  background: #fbf0d6;
  border-color: #e4c991;
  color: #8c5c19;
}

/* 大数字余额 */
.credits__balance-main {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.credits__balance-num {
  font-size: 48px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -1.4px;
  color: var(--ink);
}

.credits__balance-unit {
  font-size: 14px;
  font-weight: 600;
  color: #6b5839;
}

/* The ledger belongs beside the available balance after removing the redundant sync row. */
.credits__hero--balance {
  gap: 2px;
  padding-top: 12px;
}

.credits__hero--balance .credits__hero-art {
  width: 65px;
  height: 65px;
}

.credits__hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.credits__ledger-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  width: auto !important;
  margin: 0 !important;
  min-height: 36px;
  padding: 0 2px 0 10px;
  color: #4d3f29;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  flex: none;
}

.credits__ledger-arrow {
  width: 14px;
  height: 14px;
  opacity: 0.7;
  flex: none;
}

/* 充值卷豆主区块 */
.credits__section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.credits__section-title {
  padding-left: 2px;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
}

.credits__pack-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 11px;
}

.credits__pack {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6px;
  width: 100% !important;
  margin: 0 !important;
  min-height: 66px;
  padding: 11px 14px;
  border-radius: 18px;
  border: 1.5px solid #e9dfce;
  background: var(--card);
  box-shadow: 0 3px 0 #eae1d0;
  text-align: left;
}

.credits__pack--featured {
  grid-column: 1 / -1;
  flex-direction: row;
  align-items: center;
  min-height: 60px;
  padding: 12px 16px;
}

.credits__pack--on {
  border-color: #18181b;
  background: #f5e8cc;
  box-shadow: 0 3px 0 #dfd0b1;
}

.credits__pack-count {
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.credits__pack-unit {
  font-size: 11px;
  font-weight: 500;
  color: #7c694a;
}

.credits__pack-price {
  font-size: 17px;
  font-weight: 700;
  color: #8c5c19;
  line-height: 1.1;
}

.credits__pack-price--lg {
  font-size: 24px;
  color: var(--ink);
}

.credits__payment-state {
  display: flex;
  align-items: center;
  padding: 2px 2px 0;
  font-size: 12px;
  line-height: 1.5;
  color: #6b5839;
}

.credits__payment-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 纸卡主题支付提示弹窗 */
.credits__dialog-layer {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 22px 44px;
  box-sizing: border-box;
}

.credits__dialog-shade {
  position: absolute;
  inset: 0;
  background: rgba(249, 246, 239, 0.58);
  -webkit-backdrop-filter: blur(9px);
  backdrop-filter: blur(9px);
}

.credits__dialog {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 316px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 26px 22px 22px;
  border-radius: 24px;
  border: 1px solid #e7dbc6;
  background: #fffdf8;
  box-shadow: 0 4px 0 #e9decb, 0 18px 42px rgba(74, 58, 36, 0.14);
  box-sizing: border-box;
  animation: creditsDialogIn 0.22s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes creditsDialogIn {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.credits__dialog-badge {
  width: 52px;
  height: 52px;
  margin-bottom: 14px;
  border-radius: 18px;
  background: #f7ecd6;
  border: 1px solid #e8d8b8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.credits__dialog-badge--error {
  background: #fbece9;
  border-color: #f1cdc7;
}

.credits__dialog-badge--pending {
  background: #f7ecd6;
  border-color: #e6d3ad;
}

.credits__dialog-badge--info {
  background: #f7ecd6;
  border-color: #e6d3ad;
}

.credits__dialog-icon {
  width: 26px;
  height: 26px;
  flex: none;
}

.credits__dialog-title {
  font-size: 17px;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
}

.credits__dialog-desc {
  margin-top: 8px;
  font-size: 13.5px;
  line-height: 1.6;
  color: #6b5839;
}

.credits__dialog-detail {
  width: 100%;
  margin-top: 12px;
  padding: 9px 11px;
  border-radius: 12px;
  background: #f8f2e7;
  border: 1px solid #eadfcd;
  box-sizing: border-box;
  text-align: left;
}

.credits__dialog-detail-text {
  display: block;
  font-size: 11.5px;
  line-height: 1.45;
  color: #85745c;
  overflow-wrap: anywhere;
  word-break: normal;
}

.credits__dialog-actions {
  width: 100%;
  margin-top: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.credits__dialog-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14.5px;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.credits__dialog-btn--primary {
  background: #18181b !important;
  color: #fffaf0 !important;
}

.credits__dialog-btn--soft {
  background: #f3ead9 !important;
  color: #4d3f29 !important;
  border: 1px solid #e4d6bc;
}

/* 底部固定结算栏 */
.credits__footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 12px 22px calc(16px + env(safe-area-inset-bottom));
  background: rgba(252, 248, 241, 0.96);
  border-top: 1px solid #ebe2d3;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}

.credits__footer-price {
  font-size: 24px;
  line-height: 1.1;
  font-weight: 700;
  color: var(--ink);
}

.credits__footer-btn {
  flex: 1;
  max-width: 210px;
  width: auto !important;
  margin: 0 !important;
  min-height: 46px;
  padding: 0 22px;
  border-radius: 23px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #18181b;
  color: #fffaf0;
  font-size: 15px;
  font-weight: 650;
}

button.credits__footer-btn[disabled] {
  background: #e6ddcc;
  color: #6b5839;
  opacity: 1;
}

/* 未登录状态 */
.credits__guest-title {
  font-size: 21px;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--ink);
}

.credits__guest-desc {
  font-size: 13px;
  line-height: 1.5;
  color: #6b5839;
}

.credits__bind-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  width: 100% !important;
  margin: 0 !important;
  padding: 11px 12px;
  border-radius: 14px;
  background: rgba(255, 253, 248, 0.78);
  border: 1px solid #e4d4b4;
  text-align: left;
}

.credits__bind-row--on {
  background: #fffdf8;
  border-color: #d6be91;
}

.credits__checkbox {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  border-radius: 6px;
  border: 1.5px solid #bda884;
  background: #fffdf8;
  display: grid;
  place-items: center;
  flex: none;
}

.credits__checkbox--on {
  border-color: #18181b;
  background: #18181b;
}

.credits__check-icon {
  width: 11px;
  height: 11px;
  flex: none;
}

.credits__bind-title {
  font-size: 13px;
  font-weight: 650;
  color: var(--ink);
}

.credits__bind-hint {
  margin-top: 2px;
  font-size: 11px;
  line-height: 1.45;
  color: #7c694a;
}

.credits__login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin: 0 !important;
  min-height: 46px;
  border-radius: 23px;
  background: #18181b;
  color: #fffaf0;
  font-size: 15px;
  font-weight: 650;
}

.credits__login-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.credits__skip-bind {
  width: 100% !important;
  margin: 0 !important;
  min-height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #6b5839;
  text-decoration: underline;
}

.credits__closed-note {
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(255, 253, 248, 0.72);
  color: #6b5839;
  font-size: 12px;
  text-align: center;
}

/* 可选扩展渠道列表卡 */
.credits__menu {
  padding: 0 16px;
  border: 1px solid #e9dfce;
  border-radius: 20px;
  background: var(--card);
  box-shadow: 0 3px 0 #eae1d0;
}

.credits__menu-row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100% !important;
  margin: 0 !important;
  min-height: 54px;
  padding: 10px 0;
  text-align: left;
}

.credits__menu-row + .credits__menu-row {
  border-top: 1px solid #f0e8da;
}

.credits__menu-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  flex: none;
}

.credits__menu-icon-wrap {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  background: #fbf1dc;
  border: 1px solid #ead8b5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.credits__menu-icon {
  width: 18px;
  height: 18px;
  flex: none;
}

.credits__menu-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.credits__menu-sub {
  font-size: 12px;
  line-height: 1.3;
  color: #7c694a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credits__menu-value {
  font-size: 13px;
  color: #85745c;
  text-align: right;
}

.credits__menu-value--accent {
  color: #9e6d2b;
  font-weight: 600;
}

.credits__menu-arrow {
  width: 15px;
  height: 15px;
  flex: none;
  opacity: 0.6;
}

/* 底部抽屉 */
.credits__sheet {
  padding-top: 4px;
}

.credits__list {
  display: flex;
  flex-direction: column;
}

.credits__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 0;
}

.credits__item + .credits__item {
  border-top: 1px solid #f0e8da;
}

.credits__item-main {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.credits__item-head {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}

.credits__item-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
}

.credits__item-tag {
  flex: none;
  padding: 1px 7px;
  border-radius: 999px;
  background: #f5efe3;
  color: #7c694a;
  font-size: 11px;
  white-space: nowrap;
}

.credits__item-time {
  font-size: 11px;
  color: var(--quiet);
}

.credits__item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  flex: none;
}

.credits__item-amount {
  font-size: 16px;
  font-weight: 700;
}

.credits__item-amount--pos {
  color: var(--green);
}

.credits__item-amount--neg {
  color: #c2565c;
}

.credits__item-balance {
  font-size: 11px;
  color: var(--quiet);
  white-space: nowrap;
}

.credits__empty {
  padding: 36px 0;
  text-align: center;
  font-size: 13px;
  color: var(--quiet);
}

.credits__more-btn {
  width: 100% !important;
  margin: 12px 0 4px !important;
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: var(--paper-deep);
  color: #574b3a;
  font-size: 13px;
  font-weight: 600;
}

.credits__end-note {
  padding: 12px 0 4px;
  text-align: center;
  font-size: 12px;
  color: #9b9286;
}

/* 分享得卷豆抽屉：暖金纸卡邀请券 */
.credits__referral-sheet {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 4px 0 4px;
}

.credits__qr-card {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: 22px;
  border: 1px solid #e4d2ad;
  background: #ffffff;
  box-shadow: 0 3px 0 #e7d8b8, 0 12px 26px rgba(74, 58, 36, 0.07);
}

.credits__voucher-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 16px 16px 8px;
  border-radius: 21px 21px 0 0;
  background: linear-gradient(180deg, #f7ebd0 0%, #efdeb9 100%);
}

.credits__voucher-reward {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}

.credits__voucher-badge {
  width: 40px;
  height: 40px;
  border-radius: 13px;
  background: rgba(255, 253, 248, 0.88);
  border: 1px solid rgba(224, 200, 152, 0.85);
  box-shadow: 0 2px 6px rgba(133, 94, 28, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.credits__voucher-icon {
  width: 22px;
  height: 22px;
  flex: none;
}

.credits__voucher-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.credits__voucher-eyebrow {
  font-size: 11.5px;
  font-weight: 600;
  line-height: 1.2;
  color: #7c633b;
}

.credits__voucher-value {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.credits__voucher-num {
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.6px;
  color: #b4474e;
}

.credits__voucher-unit {
  font-size: 12.5px;
  font-weight: 650;
  color: #5a4421;
}

.credits__voucher-quota {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(255, 253, 248, 0.78);
  border: 1px solid rgba(214, 189, 140, 0.72);
  color: #6b5636;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  flex: none;
}

.credits__voucher-quota-icon {
  width: 14px;
  height: 14px;
  opacity: 0.82;
  flex: none;
}

.credits__voucher-cut {
  position: relative;
  height: 16px;
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #efdeb9 0%, #efdeb9 50%, #ffffff 50%, #ffffff 100%);
}

.credits__voucher-dash {
  width: 100%;
  margin: 0 14px;
  border-top: 1.5px dashed #d8c39b;
}

.credits__voucher-notch {
  position: absolute;
  top: 0;
  z-index: 2;
  width: 9px;
  height: 16px;
  background: #fffdf8;
  border: 1px solid #e4d2ad;
  box-sizing: border-box;
}

.credits__voucher-notch--left {
  left: -1px;
  border-left: 0;
  border-radius: 0 9px 9px 0;
}

.credits__voucher-notch--right {
  right: -1px;
  border-right: 0;
  border-radius: 9px 0 0 9px;
}

.credits__voucher-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 16px 16px 18px;
  border-radius: 0 0 21px 21px;
  background: #ffffff;
}

.credits__qr-img {
  display: block;
  width: 164px;
  height: 164px;
  border-radius: 14px;
}

.credits__qr-caption {
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.4px;
  color: #96856a;
  text-align: center;
}

.credits__referral-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.credits__referral-btn {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
  min-height: 46px;
  padding: 0 14px;
  border-radius: 23px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 650;
  white-space: nowrap;
}

.credits__referral-btn--soft {
  background: #f3ead9;
  color: #463a28;
  border: 1px solid #e4d6bc;
}

.credits__referral-btn--primary {
  background: #18181b;
  color: #fffaf0;
}

.credits__referral-btn[disabled] {
  opacity: 0.55;
}

/* 邀请抽屉 */
.credits__invite-sheet {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 6px 0 4px;
}

.credits__invite-desc {
  font-size: 13px;
  line-height: 1.55;
  color: var(--ink-soft);
}

.credits__invite-code-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 14px;
  background: #faf6ee;
  border: 1px dashed #d8c6a5;
}

.credits__invite-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: var(--ink);
}

.credits__copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  width: auto !important;
  margin: 0 !important;
  min-height: 32px;
  padding: 0 11px;
  border-radius: 10px;
  background: #fffdf8;
  border: 1px solid #e2d6c0;
  color: #463a28;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  flex: none;
}

.credits__copy-icon {
  width: 13px;
  height: 13px;
  flex: none;
}

.credits__share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  width: 100% !important;
  margin: 0 !important;
  min-height: 44px;
  border-radius: 22px;
  background: #2d2c25;
  color: #fffaf0;
  font-size: 14px;
  font-weight: 650;
}

.credits__share-icon {
  width: 16px;
  height: 16px;
  flex: none;
}

/* 行内错误提示 */
.credits__inline-error {
  padding: 9px 12px;
  border-radius: 12px;
  background: #fbe9e7;
  color: #a93b32;
  font-size: 12.5px;
  line-height: 1.45;
}

@media (max-width: 350px) {
  .credits {
    padding-inline: 16px;
    gap: 14px;
  }

  .credits__hero {
    padding: 16px 14px 12px;
  }

  .credits__hero--balance {
    padding-top: 10px;
  }

  .credits__hero-art {
    width: 68px;
    height: 68px;
  }

  .credits__balance-num {
    font-size: 42px;
  }

  .credits__pack {
    min-height: 60px;
    padding: 8px 12px;
  }

  .credits__pack--featured {
    min-height: 54px;
  }

  .credits__section {
    gap: 9px;
  }

  .credits__footer {
    padding-inline: 16px;
  }

  .credits__dialog-layer {
    padding: 18px 16px 32px;
  }

  .credits__dialog {
    padding: 22px 18px 18px;
    border-radius: 22px;
  }

  .credits__dialog-btn {
    padding: 0 12px;
    font-size: 14px;
  }

  .credits__referral-sheet {
    gap: 12px;
  }

  .credits__voucher-top {
    padding: 13px 13px 6px;
  }

  .credits__voucher-badge {
    width: 36px;
    height: 36px;
    border-radius: 11px;
  }

  .credits__voucher-icon {
    width: 20px;
    height: 20px;
  }

  .credits__voucher-num {
    font-size: 24px;
  }

  .credits__voucher-body {
    padding: 12px 14px 14px;
    gap: 8px;
  }

  .credits__qr-img {
    width: 140px;
    height: 140px;
  }

  .credits__referral-btn {
    min-height: 44px;
  }
}
