<page-meta page-style="overflow: hidden;" />
<view class="screen screen--plain">
  <rr-nav title="卷豆" />
  <scroll-view
    class="page-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    refresher-background="#fcf8f1"
    bindrefresherrefresh="onRefresherRefresh"
  >
    <view class="{{signedIn ? 'credits__scroll-body' : 'page-scroll__body--plain'}}">
      <view class="credits">
        <view wx:if="{{loading}}" class="credits__loading">正在读取…</view>

        <view wx:elif="{{error && !signedIn}}" class="state-card state-card--standalone">
          <view class="state-card__badge">
            <image class="state-card__icon" src="/assets/ui/warn-ochre.svg" mode="aspectFit" />
          </view>
          <text class="state-card__title">暂时无法连接</text>
          <text class="state-card__desc">{{error}}</text>
          <button class="state-card__btn" bindtap="reload" hover-class="press">
            <image class="state-card__btn-icon" src="/assets/ui/refresh-light.svg" mode="aspectFit" />
            <text>重新读取</text>
          </button>
        </view>

        <block wx:else>
          <!-- 未登录态 -->
          <view wx:if="{{!signedIn}}" class="credits__hero">
            <view class="credits__hero-main">
              <view class="credits__hero-copy grow">
                <view class="credits__eyebrow">
                  <image class="credits__eyebrow-icon" src="{{uiBase}}/bean-ochre.svg" mode="aspectFit" />
                  <text>卷豆</text>
                  <text class="credits__pill credits__pill--coral">首登送 3 颗</text>
                </view>
                <text class="credits__guest-title">登录领取卷豆</text>
                <text class="credits__guest-desc">使用同一微信账号，换设备自动同步余额。</text>
              </view>
              <image class="credits__hero-art" src="/assets/credits-art.svg" mode="aspectFit" />
            </view>

            <button
              wx:if="{{legacyEligible}}"
              class="credits__bind-row {{bindLegacy ? 'credits__bind-row--on' : ''}}"
              bindtap="toggleBindLegacy"
              aria-pressed="{{bindLegacy}}"
            >
              <view class="credits__checkbox {{bindLegacy ? 'credits__checkbox--on' : ''}}">
                <image wx:if="{{bindLegacy}}" class="credits__check-icon" src="{{uiBase}}/check-light.svg" mode="aspectFit" />
              </view>
              <view class="stack grow">
                <text class="credits__bind-title">关联本机练习资料</text>
                <text class="credits__bind-hint">核对既有资料或正式回执，领取首次绑定赠送</text>
              </view>
            </button>

            <text wx:if="{{loginError}}" class="credits__inline-error" aria-role="alert">{{loginError}}</text>

            <button
              wx:if="{{capabilities.login}}"
              class="credits__login-btn"
              bindtap="onLogin"
              loading="{{loggingIn}}"
              disabled="{{loggingIn}}"
            >
              {{loggingIn ? '正在登录…' : '微信登录'}}
            </button>
            <view wx:else class="credits__closed-note">
              <text>微信登录暂未开放</text>
            </view>

            <button
              wx:if="{{canSkipBind}}"
              class="credits__skip-bind"
              bindtap="loginWithoutBind"
              disabled="{{loggingIn}}"
            >
              取消关联并直接登录
            </button>
          </view>

          <block wx:else>
            <view class="credits__hero credits__hero--balance">
              <view class="credits__hero-head">
                <view class="credits__eyebrow">
                  <image class="credits__eyebrow-icon" src="{{uiBase}}/bean-ochre.svg" mode="aspectFit" />
                  <text>可用卷豆</text>
                  <text wx:if="{{held > 0}}" class="credits__pill credits__pill--ochre">占用 {{held}}</text>
                </view>
                <button class="credits__ledger-link" bindtap="openLedger">
                  <text>到账明细</text>
                  <image class="credits__ledger-arrow" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
                </button>
              </view>
              <view class="credits__hero-main">
                <view class="credits__balance-main grow">
                  <text class="display-num credits__balance-num">{{balance}}</text>
                  <text class="credits__balance-unit">颗</text>
                </view>
                <image class="credits__hero-art" src="/assets/credits-art.svg" mode="aspectFit" />
              </view>
            </view>

            <text wx:if="{{error}}" class="credits__inline-error" aria-role="alert">{{error}}</text>

            <view class="credits__section">
              <text class="credits__section-title">充值卷豆</text>

              <view class="credits__pack-grid">
                <button
                  wx:for="{{packages}}"
                  wx:key="credits"
                  class="credits__pack {{item.featured ? 'credits__pack--featured' : ''}} {{selectedPackIndex === index ? 'credits__pack--on' : ''}}"
                  data-index="{{index}}"
                  bindtap="selectPackage"
                  aria-pressed="{{selectedPackIndex === index}}"
                  disabled="{{rechargeAction || rechargeOrder}}"
                >
                  <text class="credits__pack-count num">{{item.credits}}<text class="credits__pack-unit"> 颗</text></text>
                  <text class="credits__pack-price {{item.featured ? 'credits__pack-price--lg' : ''}} num">{{item.yuanText}}</text>
                </button>
              </view>

              <view wx:if="{{rechargeMessage || (!rechargeOrder && rechargeDeviceMessage && !rechargeTestGuide)}}" class="credits__payment-state">
                <text aria-role="status">{{rechargeMessage || rechargeDeviceMessage}}</text>
              </view>
            </view>

            <!-- 其他已开通的获取渠道（未开通自动隐藏） -->
            <view wx:if="{{capabilities.invite || capabilities.ads}}" class="credits__menu">
              <button wx:if="{{capabilities.invite}}" class="credits__menu-row" bindtap="openInvite">
                <text class="credits__menu-label">邀请好友</text>
                <text class="credits__menu-value credits__menu-value--accent grow">领卷豆</text>
                <image class="credits__menu-arrow" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
              </button>
              <view wx:if="{{capabilities.ads}}" class="credits__menu-row">
                <text class="credits__menu-label">看视频领卷豆</text>
                <text class="credits__menu-value grow">每日限量</text>
                <image class="credits__menu-arrow" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
              </view>
            </view>
          </block>
        </block>
      </view>
    </view>
  </scroll-view>

  <!-- 底部固定充值栏（仅已登录态） -->
  <view wx:if="{{!loading && signedIn}}" class="credits__footer">
    <text class="display-num credits__footer-price">{{rechargeOrder ? rechargeOrder.yuanText : packages[selectedPackIndex].yuanText}}</text>
    <button
      class="credits__footer-btn"
      bindtap="submitRecharge"
      disabled="{{!!rechargeAction || (!rechargeOrder && (!purchaseReady || (!!rechargeDeviceMessage && !rechargeTestGuide)))}}"
    >
      <block wx:if="{{rechargeAction}}">{{rechargeAction}}</block>
      <block wx:elif="{{rechargeOrder}}">查询到账</block>
      <block wx:elif="{{rechargeTestGuide === 'ios'}}">iPhone 充值说明</block>
      <block wx:elif="{{rechargeTestGuide}}">真机测试</block>
      <block wx:else>{{purchaseReady && !rechargeDeviceMessage ? '立即充值' : '充值暂未开放'}}</block>
    </button>
  </view>

  <!-- 底部抽屉：卷豆明细 / 邀请好友（点击空白遮罩或下拉均可关闭） -->
  <view
    wx:if="{{sheet}}"
    class="sheet-layer {{sheetDragging ? 'sheet-layer--dragging' : ''}} {{sheetClosing ? 'sheet-layer--closing' : ''}}"
  >
    <view
      class="sheet-shade"
      style="{{sheetShadeOpacity < 1 ? 'opacity: ' + sheetShadeOpacity + ';' : ''}}"
      catchtap="closeSheet"
      catchtouchmove="noopSheet"
    ></view>
    <view
      class="sheet-panel credits__sheet"
      style="{{sheetDragY ? 'transform: translateY(' + sheetDragY + 'px);' : ''}}"
      aria-role="dialog"
      aria-label="{{sheet === 'ledger' ? '到账明细' : '邀请好友'}}"
      bindtouchstart="startSheetDrag"
      bindtouchmove="moveSheetDrag"
      bindtouchend="endSheetDrag"
      bindtouchcancel="cancelSheetDrag"
    >
      <view
        class="sheet-grabber-zone"
        data-sheet-zone="handle"
        catchtouchstart="startSheetDrag"
        catchtouchmove="moveSheetDrag"
        catchtouchend="endSheetDrag"
        catchtouchcancel="cancelSheetDrag"
      >
        <view class="sheet-grabber"></view>
      </view>

      <view class="sheet-head">
        <text>{{sheet === 'ledger' ? '到账明细' : '邀请好友'}}</text>
        <button class="sheet-close" data-sheet-no-drag="1" catchtap="closeSheet" aria-label="关闭">
          <image data-sheet-no-drag="1" src="{{uiBase}}/close.svg" mode="aspectFit" />
        </button>
      </view>

      <!-- 卷豆明细抽屉 -->
      <scroll-view
        wx:if="{{sheet === 'ledger'}}"
        class="sheet-scroll"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        bindscroll="onSheetScroll"
      >
        <view wx:if="{{records.length}}" class="credits__list">
          <view wx:for="{{records}}" wx:key="id" class="credits__item">
            <view class="credits__item-main grow">
              <view class="credits__item-head">
                <text class="credits__item-title ellipsis">{{item.title}}</text>
                <text wx:if="{{item.tool}}" class="credits__item-tag">{{item.tool}}</text>
              </view>
              <text class="credits__item-time">{{item.timeText}}</text>
            </view>
            <view class="credits__item-right">
              <text class="num credits__item-amount {{item.positive ? 'credits__item-amount--pos' : 'credits__item-amount--neg'}}">{{item.amountText}}</text>
              <text wx:if="{{item.balanceText}}" class="credits__item-balance">{{item.balanceText}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="credits__empty">暂无明细</view>

        <button
          wx:if="{{nextBefore !== null}}"
          class="credits__more-btn"
          bindtap="loadMore"
          loading="{{loadingMore}}"
          disabled="{{loadingMore}}"
        >
          {{loadingMore ? '加载中…' : '加载更多'}}
        </button>
        <view wx:elif="{{records.length}}" class="credits__end-note">已显示全部明细</view>
      </scroll-view>

      <!-- 邀请好友抽屉 -->
      <view wx:elif="{{sheet === 'invite'}}" class="credits__invite-sheet">
        <block wx:if="{{invite}}">
          <text class="credits__invite-desc">
            新卷友 {{invite.useDays}} 天内完成首次有效使用，你可获 {{invite.reward}} 颗卷豆，每月最多 {{invite.monthlyLimit}} 位。
          </text>
          <view class="credits__invite-code-box">
            <text class="credits__invite-code">{{invite.code}}</text>
            <button class="credits__copy-btn" bindtap="copyInviteCode">
              <image class="credits__copy-icon" src="{{uiBase}}/copy.svg" mode="aspectFit" />
              <text>复制</text>
            </button>
          </view>
          <button class="credits__share-btn" open-type="share">
            <image class="credits__share-icon" src="{{uiBase}}/share-light.svg" mode="aspectFit" />
            <text>分享到微信群</text>
          </button>
        </block>
        <view wx:else class="credits__empty">{{inviteLoading ? '正在生成邀请码…' : '暂无法获取邀请码'}}</view>
      </view>
    </view>
  </view>
</view>
