<page-meta page-style="overflow: hidden;" />
<view class="screen {{publicView ? 'screen--plain' : ''}}">
  <rr-nav title="{{publicView ? '公开成绩' : '练习估分'}}" action-icon="{{summary && !publicView ? 'refresh' : ''}}" action-label="重新练习本卷" bind:action="practiceAgain" />

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#fcf8f1" bindrefresherrefresh="onRefresherRefresh">
  <view class="page-scroll__body {{publicView ? 'page-scroll__body--plain' : ''}}">
  <view wx:if="{{loading}}" class="loading">正在核分…</view>
  <view wx:elif="{{error}}" class="state-wrap">
    <view class="state-card">
      <view class="state-card__badge">
        <image class="state-card__icon" src="/assets/ui/warn-ochre.svg" mode="aspectFit" />
      </view>
      <text class="state-card__title">暂时无法连接</text>
      <text class="state-card__desc">{{error}}</text>
      <button class="state-card__btn" bindtap="retry" hover-class="press">
        <image class="state-card__btn-icon" src="/assets/ui/refresh-light.svg" mode="aspectFit" />
        <text>重新读取</text>
      </button>
    </view>
  </view>

  <view wx:elif="{{summary}}" class="report__body">
    <view class="report__hero">
      <view class="report__total">
        <text wx:if="{{publicView}}" class="report__score-label">{{summary.name}}</text>
        <text wx:elif="{{summary.identity}}" class="report__paper-label ellipsis">{{summary.identity}}</text>
        <text class="display-num report__score {{summary.score.length > 5 ? 'report__score--wide' : ''}}" aria-label="总分 {{summary.score}}">{{summary.score}}</text>
        <text class="report__max">/ {{summary.max}} 分</text>
        <image class="report__stamp" src="/assets/score-ribbon.svg" mode="aspectFit" />
      </view>

      <view wx:if="{{!publicView}}" class="report__stats {{summary.blank ? 'report__stats--three' : ''}}">
        <view class="report__stat report__stat--ok" aria-label="正确 {{summary.correct}} 题">
          <view class="report__stat-icon"><image src="{{uiBase}}/check.svg" mode="aspectFit" /></view>
          <text class="num report__stat-num">{{summary.correct}}</text>
        </view>
        <view class="report__stat report__stat--no" aria-label="错误 {{summary.wrong}} 题">
          <view class="report__stat-icon"><image src="{{uiBase}}/close.svg" mode="aspectFit" /></view>
          <text class="num report__stat-num">{{summary.wrong}}</text>
        </view>
        <view wx:if="{{summary.blank}}" class="report__stat report__stat--blank" aria-label="未答 {{summary.blank}} 题">
          <view class="report__stat-icon"></view>
          <text class="num report__stat-num">{{summary.blank}}</text>
        </view>
      </view>

      <button wx:if="{{!publicView}}" class="report__rank" bindtap="rank">
        <image src="{{uiBase}}/trophy.svg" mode="aspectFit" />
        <text class="grow">同卷排名</text>
        <block wx:if="{{standing && standing.rank}}">
          <text class="report__rank-count">{{standing.rank}}</text><text class="report__rank-total">/ {{standing.count}}</text>
        </block>
        <image class="report__rank-arrow" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
      </button>
      <button wx:if="{{correctionNotice}}" class="report__correction" bindtap="showCorrectionNotice" aria-label="答案已订正，成绩 {{correctionNotice.beforeText}} 调整为 {{correctionNotice.afterText}}，变化 {{correctionNotice.deltaText}}">
        <image src="{{uiBase}}/check.svg" mode="aspectFit" />
        <text class="report__correction-label grow">答案已订正</text>
        <text class="num report__correction-scores">{{correctionNotice.beforeText}} → {{correctionNotice.afterText}}</text>
        <text class="num report__correction-delta report__correction-delta--{{correctionNotice.deltaTone}}">{{correctionNotice.deltaText}}</text>
        <image class="report__correction-arrow" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
      </button>
    </view>

    <view wx:if="{{timing}}" class="report__timing">
      <button class="report__timing-toggle {{timingOpen ? 'report__timing-toggle--open' : ''}}" bindtap="toggleTiming" aria-expanded="{{timingOpen}}">
        <image src="{{uiBase}}/clock.svg" mode="aspectFit" />
        <text class="grow">做题用时</text>
        <text class="num report__timing-clock">{{timing.actual}}</text>
        <image class="report__timing-arrow" src="{{uiBase}}/chevron-down.svg" mode="aspectFit" />
      </button>
      <view wx:if="{{timingOpen}}" class="report__timing-detail">
        <view class="row row--between"><text>计划 {{timing.planned}} 分</text><text>录答 {{timing.entry}}</text></view>
        <block wx:if="{{timing.modules.length}}">
          <view class="report__timing-row"><text>模块</text><text>计划</text><text>实际</text><text>差值</text></view>
          <view wx:for="{{timing.modules}}" wx:key="id" class="report__timing-row"><text>{{item.name}}</text><text>{{item.planned}} 分</text><text>{{item.actual}}</text><text>{{item.difference}}</text></view>
        </block>
      </view>
    </view>

    <button wx:if="{{comparison}}" class="report__vs report__vs--compact" bindtap="openVsDetail" hover-class="press" aria-label="本次对比，上次 {{comparison.previousScore}} 分，本次 {{comparison.currentScore}} 分，点击查看详情">
      <view class="report__vs-head">
        <text class="report__heading">本次对比</text>
        <view class="report__vs-meta">
          <text class="num report__vs-pill report__vs-pill--{{comparison.deltaTone}}">{{comparison.deltaText}}{{comparison.deltaCents !== 0 ? ' 分' : ''}}</text>
          <text class="report__vs-more">详情</text>
          <image class="report__vs-more-icon" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="report__vs-pair">
        <view class="report__vs-card report__vs-card--prev">
          <text class="report__vs-tag">上次</text>
          <view class="report__vs-val"><text class="display-num">{{comparison.previousScore}}</text><text class="report__vs-unit">分</text></view>
        </view>
        <text class="report__vs-badge" aria-hidden="true">VS</text>
        <view class="report__vs-card report__vs-card--curr">
          <text class="report__vs-tag">本次 · 第{{comparison.attemptCount}}次</text>
          <view class="report__vs-val"><text class="display-num">{{comparison.currentScore}}</text><text class="report__vs-unit">分</text></view>
        </view>
      </view>
    </button>

    <view wx:if="{{bands.length >= 3}}" class="report__radar">
      <view class="report__radar-head">
        <text class="report__heading">能力概览</text>
      </view>
      <rr-radar bands="{{bands}}" />
    </view>

    <view wx:if="{{bands.length}}" class="report__bands">
      <view class="report__bands-head">
        <text class="report__heading">板块表现</text>
        <button class="icon-button {{showBands ? 'report__all--open' : ''}}" bindtap="toggleBands" aria-label="{{showBands ? '收起板块' : '查看全部板块'}}" aria-expanded="{{showBands}}"><image src="{{uiBase}}/chevron-down.svg" mode="aspectFit" /></button>
      </view>
      <view class="report__bands-grid">
        <button wx:for="{{shownBands}}" wx:key="name" class="report__band" data-type="{{item.name}}" bindtap="reviewBand" disabled="{{publicView}}">
          <view class="row row--between"><text>{{item.name}}</text><image wx:if="{{!publicView}}" src="{{uiBase}}/chevron.svg" mode="aspectFit" /></view>
          <text class="display-num report__band-value">{{item.percent}}</text>
          <text class="num report__caption">{{item.hasCounts ? ('对 ' + item.correct + ' / ' + item.count + ' 题') : (item.earned + ' / ' + item.max + ' 分')}}</text>
          <view class="report__band-progress"><view style="width: {{item.pct}}%;"></view></view>
        </button>
      </view>
    </view>
  </view>
  </view>
  </scroll-view>

  <view wx:if="{{vsOpen && comparison}}" class="sheet-layer {{sheetDragging ? 'sheet-layer--dragging' : ''}} {{sheetClosing ? 'sheet-layer--closing' : ''}}">
    <view class="sheet-shade" style="{{sheetShadeOpacity < 1 ? 'opacity: ' + sheetShadeOpacity + ';' : ''}}" catchtap="closeVsDetail" catchtouchmove="noopSheet"></view>
    <view class="sheet-panel report__vs-sheet" style="{{sheetDragY ? 'transform: translateY(' + sheetDragY + 'px);' : ''}}"
      bindtouchstart="startSheetDrag" bindtouchmove="moveSheetDrag" bindtouchend="endSheetDrag" bindtouchcancel="cancelSheetDrag">
      <view class="sheet-grabber-zone" data-sheet-zone="handle" catchtouchstart="startSheetDrag" catchtouchmove="moveSheetDrag" catchtouchend="endSheetDrag" catchtouchcancel="cancelSheetDrag">
        <view class="sheet-grabber"></view>
      </view>
      <view class="sheet-head">
        <text>对比详情</text>
        <button class="sheet-close" data-sheet-no-drag="1" catchtap="closeVsDetail" aria-label="关闭"><image data-sheet-no-drag="1" src="{{uiBase}}/close.svg" mode="aspectFit" /></button>
      </view>
      <scroll-view scroll-y class="sheet-scroll" enhanced show-scrollbar="{{false}}" bindscroll="onSheetScroll">
        <view class="report__vs-detail">
          <view class="report__vs-pair">
            <button class="report__vs-card report__vs-card--prev" bindtap="openPrevious" aria-label="上一刷 {{comparison.previousScore}} 分，查看报告">
              <text class="report__vs-tag">上次 · 查看报告</text>
              <view class="report__vs-val"><text class="display-num">{{comparison.previousScore}}</text><text class="report__vs-unit">分</text></view>
            </button>
            <text class="report__vs-badge" aria-hidden="true">VS</text>
            <view class="report__vs-card report__vs-card--curr">
              <text class="report__vs-tag">本次 · 第{{comparison.attemptCount}}次</text>
              <view class="report__vs-val"><text class="display-num">{{comparison.currentScore}}</text><text class="report__vs-unit">分</text></view>
            </view>
          </view>
          <view class="report__vs-delta report__vs-delta--{{comparison.deltaTone}}">
            <text class="display-num">{{comparison.deltaText}}</text>
            <text wx:if="{{comparison.deltaCents !== 0}}" class="report__vs-delta-unit">分</text>
          </view>
          <view class="report__vs-rates">
            <view wx:for="{{comparison.rates}}" wx:key="key" class="report__vs-rate">
              <text class="report__vs-rate-label">{{item.label}}</text>
              <view class="report__vs-rate-vals">
                <text class="num report__vs-rate-prev">{{item.before}}</text>
                <text class="report__vs-rate-arrow">→</text>
                <text class="num report__vs-rate-curr">{{item.after}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{comparison.subjects.length}}" class="report__vs-subjects">
            <view class="report__vs-subhead">
              <text class="report__vs-subtitle">板块变化</text>
              <view class="report__vs-legend">
                <view class="report__vs-legend-item"><view class="report__vs-tick-demo"></view><text>上次</text></view>
                <view class="report__vs-legend-item"><view class="report__vs-fill-demo"></view><text>本次</text></view>
                <text class="report__vs-legend-unit">百分点</text>
              </view>
            </view>
            <view class="report__vs-grid">
              <view wx:for="{{comparison.subjects}}" wx:key="name" class="report__vs-sub">
                <view class="report__vs-subtop">
                  <text class="report__vs-subname">{{item.name}}</text>
                  <text class="num report__vs-subdelta report__vs-subdelta--{{item.tone}}">{{item.deltaText}}</text>
                </view>
                <view class="report__vs-bar">
                  <view class="report__vs-bar-fill" style="width: {{item.afterPct}}%;"></view>
                  <view wx:if="{{item.beforePct !== null}}" class="report__vs-bar-tick" style="left: {{item.beforePct}}%;"></view>
                </view>
                <view class="report__vs-subvals">
                  <text class="num report__vs-subcurr">{{item.afterText}}</text>
                  <text class="num report__vs-subprev">{{item.beforeText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-actions">
        <button class="btn btn--soft" bindtap="openPrevious">查看上一刷</button>
        <button class="btn btn--primary" bindtap="openAnalytics">完整成长分析</button>
      </view>
    </view>
  </view>

  <view wx:if="{{summary && !publicView}}" class="footer-bar">
    <view class="footer-bar__inner">
      <button class="btn btn--primary" bindtap="review">
        <image class="btn__icon" src="{{uiBase}}/review-light.svg" mode="aspectFit" />
        {{summary.wrong ? '复盘错题 ' + summary.wrong : '查看答卷'}}
      </button>
      <view class="report__comment">
        <button class="btn btn--ghost" bindtap="discuss" aria-label="本卷交流"><image class="btn__icon" src="{{uiBase}}/comment.svg" mode="aspectFit" /></button>
        <text wx:if="{{commentCount !== null}}" class="report__comment-count">{{commentCount > 99 ? '99+' : commentCount}}</text>
      </view>
      <button class="btn btn--ghost" bindtap="share" aria-label="成绩分享"><image class="btn__icon" src="{{uiBase}}/share.svg" mode="aspectFit" /></button>
    </view>
  </view>
</view>
