.pos__search { margin: 14px 20px 12px; padding: 0 12px; min-height: 46px; display: flex; align-items: center; gap: 8px; border: 1px solid #e6ddce; border-radius: 14px; box-shadow: none; }
.pos__search-icon { width: 17px; height: 17px; opacity: .55; flex: none; }
.pos__search input { width: 0; }
.pos__search .chip { flex-shrink: 0; height: 36px; }
.pos__facets { white-space: nowrap; padding: 0 20px 12px; }
.pos__facet { margin-right: 6px; flex-shrink: 0; max-width: 180px; overflow: hidden; text-overflow: ellipsis; }
.pos__meta { padding: 0 20px 12px; gap: 9px; }
.pos__list { padding: 0 20px; display: flex; flex-direction: column; gap: 10px; }
.pos__item { padding: 14px; border: 1px solid #e9dfce; border-radius: 16px; box-shadow: 0 2px 0 #ece3d5; }
.pos__item--on { border-color: #d5bda0; background: #f4e9d5; }
.pos__category { height: 24px; font-size: 11px; padding: 0 8px; }
.pos__title { display: block; margin-top: 6px; font-size: 15px; font-weight: 650; overflow-wrap: anywhere; }
.pos__item-foot { margin-top: 8px; padding-top: 8px; border-top: 1px solid #eee5d6; gap: 7px; }
.pos__pager { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 16px 0 20px; }
@media (max-width: 350px) {
  .pos__search { margin-inline: 16px; }
  .pos__facets, .pos__meta, .pos__list { padding-inline: 16px; }
}
