.share { height: 100vh; min-height: 0; display: flex; flex-direction: column; padding-bottom: 0; overflow: hidden; }
.share__modes { display: flex; gap: 4px; flex: none; margin: 13px 18px 12px; padding: 3px; border-radius: 13px; background: #ebe4d9; }
.share__mode { flex: 1; width: 0 !important; min-height: 38px; color: #71717a; border-radius: 8px; font-size: 13px; white-space: nowrap; }
.share__mode--on { background: #fffdf8; color: #25221e; box-shadow: 0 1px 4px #a5998126; font-weight: 650; }
.share__preview { flex: 1; min-height: 0; height: 0; }
.share__canvas { display: block; margin: 0 auto 4px; border-radius: 17px; background: #fcf8ef; }
.share__actions { display: flex; flex: none; align-items: center; gap: 12px; padding: 12px 20px calc(16px + env(safe-area-inset-bottom)); }
.share__actions .btn { min-height: 38px; }
.share__actions .btn[disabled] { opacity: .55; }
.share__invite { width: auto !important; padding: 0 16px; border: 1px solid #e4e4e7; color: #18181b; background: #fff; white-space: nowrap; }
@media (max-width: 350px) {
  .share__modes { margin-inline: 16px; }
  .share__actions { padding-inline: 16px; gap: 9px; }
  .share__invite { padding-inline: 12px; }
}
