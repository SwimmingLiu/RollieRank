.share { height: 100vh; min-height: 0; display: flex; flex-direction: column; padding-bottom: 0; overflow: hidden; }
.share__studio { display: flex; flex: 1; min-height: 0; flex-direction: column; gap: 10px; padding: 8px 18px 0; }
.share__controls { display: flex; flex-direction: column; gap: 8px; flex: none; }
.share__modes { display: flex; gap: 4px; padding: 3px; border-radius: 13px; background: #eee7db; }
.share__mode { display: flex; align-items: center; justify-content: center; flex: 1; width: 0 !important; min-height: 36px; border-radius: 10px; color: #7c705f; font-size: 13px; white-space: nowrap; }
.share__mode--on { background: #fffdf8; color: #26211b; box-shadow: 0 2px 6px rgba(68, 52, 32, .08); font-weight: 700; }

.share__styles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
.share__style-chip { display: flex; align-items: center; justify-content: center; gap: 5px; width: 100% !important; min-height: 30px; padding: 0 6px; border-radius: 999px; border: 1px solid #e6dccb; background: #faf5ec; color: #746652; font-size: 12px; font-weight: 500; white-space: nowrap; }
.share__style-chip--on { border-color: #2c241b; background: #fffdf8; color: #221c15; font-weight: 700; box-shadow: 0 2px 6px rgba(66, 48, 26, .08); }
.share__swatch { width: 10px; height: 10px; flex: none; border-radius: 50%; border: 1px solid rgba(54, 42, 26, .22); }

.share__preview { flex: 1; min-height: 0; height: 0; width: 100%; overflow: hidden; }
.share__preview-inner { padding: 4px 6px 20px; }
.share__stage { position: relative; margin: 0 auto; overflow: hidden; border-radius: 24px; box-shadow: 0 22px 42px -24px rgba(64, 45, 20, .30), 0 3px 10px rgba(64, 45, 20, .06); }

/* ============ TICKET SHELL & THEME TOKENS ============ */
.share__artifact {
  --t-top: #f5e6c6;
  --t-top-0: #f8edd4;
  --t-top-1: #f0ddb5;
  --t-top-sheen: rgba(255, 255, 255, .52);
  --t-body: #fffdf8;
  --t-surface: #faf5eb;
  --t-surface-line: #efe6d6;
  --t-best-bg: #fdf2ef;
  --t-best-line: #f0d0c9;
  --t-border: #e5d8c0;
  --t-perf: #d6c3a1;
  --t-rule: #efe7d8;
  --t-top-ink: #1f1912;
  --t-top-muted: #7a684d;
  --t-ink: #262018;
  --t-muted: #8a7b64;
  --t-subtle: #9c8d76;
  --t-chip-bg: rgba(255, 253, 248, .82);
  --t-chip-line: rgba(194, 163, 108, .48);
  --t-ruler-track: rgba(140, 114, 72, .15);
  --t-ruler-mark: rgba(246, 232, 200, .92);
  --t-ruler-sub: rgba(140, 114, 72, .14);
  --t-ruler-start: #c99b54;
  --t-ruler-end: #d97366;
  --t-pin-halo: rgba(217, 115, 102, .25);
  --t-pin-line: #fffdf8;
  --t-bar-track: #ebe2d2;
  --t-bar-fill-0: #c89957;
  --t-bar-fill-1: #a9793e;
  --t-bar-best: #d97366;
  --t-bar-best-0: #e38477;
  --t-bar-best-1: #cc6255;
  --t-bar-low-0: #c9bda8;
  --t-bar-low-1: #b2a48d;
  --t-ref: rgba(182, 135, 74, .36);
  --t-ok: #558551;
  --t-ok-bg: #e6f0e3;
  --t-ok-ink: #3f6c3b;
  --t-no: #d97366;
  --t-no-bg: #fae7e4;
  --t-no-ink: #c4584c;
  --t-bl: #cfc4b0;
  --t-bl-bg: #efeae0;
  --t-bl-ink: #8b7c67;
  --t-qr-bg: #ffffff;
  --t-qr-line: #ebdacc;
  --t-qr-halo: rgba(217, 115, 102, .12);

  position: absolute; left: 0; top: 0;
  display: flex; flex-direction: column;
  width: 450px;
  overflow: hidden;
  transform-origin: top left;
  border: 1px solid var(--t-border);
  border-radius: 24px;
  background: var(--t-body);
  color: var(--t-ink);
  box-sizing: border-box;
}

.share__style--coral .share__artifact {
  --t-top: #f8e2da;
  --t-top-0: #fbeae3;
  --t-top-1: #f3d5ca;
  --t-top-sheen: rgba(255, 255, 255, .56);
  --t-body: #fffdf9;
  --t-surface: #fcf6f2;
  --t-surface-line: #f3e2da;
  --t-best-bg: #fdf0ec;
  --t-best-line: #efc8be;
  --t-border: #ecd4ca;
  --t-perf: #dfb7a8;
  --t-rule: #f2e4dd;
  --t-top-ink: #281b18;
  --t-top-muted: #866258;
  --t-ink: #281d19;
  --t-muted: #8e7369;
  --t-subtle: #a38a80;
  --t-chip-bg: rgba(255, 253, 249, .84);
  --t-chip-line: rgba(213, 122, 106, .36);
  --t-ruler-track: rgba(166, 98, 84, .14);
  --t-ruler-mark: rgba(248, 226, 218, .92);
  --t-ruler-sub: rgba(166, 98, 84, .14);
  --t-ruler-start: #d9927c;
  --t-ruler-end: #d45d4f;
  --t-pin-halo: rgba(212, 93, 79, .24);
  --t-pin-line: #fffdf9;
  --t-bar-track: #f2e2da;
  --t-bar-fill-0: #dc957d;
  --t-bar-fill-1: #c1745c;
  --t-bar-best: #d45d4f;
  --t-bar-best-0: #e07063;
  --t-bar-best-1: #c44d40;
  --t-bar-low-0: #d4c5bc;
  --t-bar-low-1: #bca99f;
  --t-ref: rgba(207, 133, 108, .36);
  --t-no: #d45d4f;
  --t-no-bg: #fbe6e2;
  --t-no-ink: #c04b3e;
  --t-bl: #d4c4bc;
  --t-bl-bg: #f2ebe6;
  --t-bl-ink: #8f7a70;
  --t-qr-line: #f0d7ce;
  --t-qr-halo: rgba(212, 93, 79, .12);
}

.share__style--ink .share__artifact {
  --t-top: #231f1a;
  --t-top-0: #2b251f;
  --t-top-1: #1c1814;
  --t-top-sheen: rgba(250, 240, 220, .09);
  --t-body: #2b251f;
  --t-surface: #332c24;
  --t-surface-line: #443a30;
  --t-best-bg: #412d28;
  --t-best-line: #684239;
  --t-border: #463c32;
  --t-perf: #54483a;
  --t-rule: #3d342b;
  --t-top-ink: #fbf5e8;
  --t-top-muted: #b9a78c;
  --t-ink: #f7f0e3;
  --t-muted: #b6a68d;
  --t-subtle: #968770;
  --t-chip-bg: rgba(250, 243, 230, .08);
  --t-chip-line: rgba(232, 190, 116, .36);
  --t-ruler-track: rgba(250, 243, 230, .13);
  --t-ruler-mark: rgba(28, 24, 20, .90);
  --t-ruler-sub: rgba(250, 243, 230, .12);
  --t-ruler-start: #deb064;
  --t-ruler-end: #e47c6d;
  --t-pin-halo: rgba(228, 124, 109, .32);
  --t-pin-line: #231f1a;
  --t-bar-track: #433a30;
  --t-bar-fill-0: #e4b970;
  --t-bar-fill-1: #c29147;
  --t-bar-best: #e47c6d;
  --t-bar-best-0: #ee8e80;
  --t-bar-best-1: #d46a5b;
  --t-bar-low-0: #8c7f6c;
  --t-bar-low-1: #6c6050;
  --t-ref: rgba(222, 176, 100, .34);
  --t-ok: #7cb275;
  --t-ok-bg: rgba(124, 178, 117, .17);
  --t-ok-ink: #9ad193;
  --t-no: #e47c6d;
  --t-no-bg: rgba(228, 124, 109, .17);
  --t-no-ink: #f0998c;
  --t-bl: #8c7f6c;
  --t-bl-bg: rgba(250, 243, 230, .09);
  --t-bl-ink: #b8aa95;
  --t-qr-bg: #fffdf8;
  --t-qr-line: #564a3d;
  --t-qr-halo: rgba(232, 190, 116, .18);
}

/* ============ TICKET TOP ============ */
.share__top { position: relative; background: linear-gradient(155deg, var(--t-top-0) 0%, var(--t-top-1) 100%); box-shadow: inset 0 1.5px 0 var(--t-top-sheen); padding: 22px 22px 20px; }
.share__top--compact { padding-bottom: 18px; }
.share__mast { display: flex; align-items: center; gap: 10px; min-width: 0; }
.share__logo { width: 40px; height: 40px; flex: none; border-radius: 10px; }
.share__identity-block { display: flex; flex-direction: column; flex: 1; min-width: 0; gap: 3px; }
.share__identity { color: var(--t-top-ink); font-family: FangYuan, Nunito, -apple-system, sans-serif; font-size: 22px; font-weight: 700; line-height: 1.25; letter-spacing: .2px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.share__series { color: var(--t-top-muted); font-size: 15px; line-height: 1.3; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.share__rank-chip { display: inline-flex; align-items: center; gap: 6px; flex: none; padding: 7px 12px; border-radius: 99px; background: var(--t-chip-bg); border: 1px solid var(--t-chip-line); }
.share__rank-icon { width: 18px; height: 18px; flex: none; }
.share__rank-num { font-size: 18px; font-weight: 700; color: var(--t-top-ink); line-height: 1; }
.share__rank-total { font-size: 14px; color: var(--t-top-muted); font-weight: 600; line-height: 1; }

/* Editorial Split Integer + Decimal Hero Score */
.share__hero { position: relative; display: flex; align-items: flex-end; justify-content: space-between; margin-top: 14px; min-height: 116px; }
.share__score-col { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; }
.share__score-line { display: flex; align-items: baseline; }
.share__score-int { font-size: 92px; font-weight: 700; line-height: .88; letter-spacing: -2px; color: var(--t-top-ink); }
.share__score-int--compact { font-size: 76px; letter-spacing: -1.6px; }
.share__score-dec { font-size: 50px; font-weight: 600; line-height: .9; letter-spacing: -.8px; color: var(--t-top-ink); opacity: .78; margin-left: 2px; }
.share__score-dec--compact { font-size: 40px; }
.share__score-sub { display: flex; align-items: center; gap: 10px; margin-top: 9px; }
.share__max { font-size: 17px; color: var(--t-top-muted); font-weight: 600; }
.share__delta-pill { display: inline-flex; align-items: center; gap: 4px; padding: 4px 11px 4px 9px; border-radius: 99px; font-size: 15px; font-weight: 700; }
.share__delta-icon { width: 14px; height: 14px; flex: none; }
.share__delta-pill--up { background: var(--t-ok-bg); color: var(--t-ok-ink); }
.share__delta-pill--down { background: var(--t-no-bg); color: var(--t-no-ink); }
.share__delta-pill--same { background: var(--t-bl-bg); color: var(--t-bl-ink); }

.share__art-wrap { position: absolute; right: -12px; bottom: -12px; width: 174px; height: 120px; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.share__art-halo { position: absolute; width: 110px; height: 110px; border-radius: 50%; background: rgba(246, 232, 202, .92); box-shadow: 0 0 0 5px rgba(232, 190, 116, .22), 0 0 0 6.2px rgba(232, 190, 116, .36); }
.share__art { position: relative; z-index: 1; width: 174px; height: 116px; }

/* Precision Score Ruler Gauge */
.share__ruler { margin-top: 14px; padding-top: 4px; }
.share__ruler-track { position: relative; height: 9px; border-radius: 99px; background: var(--t-ruler-track); }
.share__ruler-submark { position: absolute; top: 1.5px; bottom: 1.5px; width: 1px; background: var(--t-ruler-sub); }
.share__ruler-fill { position: relative; z-index: 1; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--t-ruler-start) 0%, var(--t-ruler-end) 100%); }
.share__ruler-mark { position: absolute; z-index: 2; top: -2px; bottom: -2px; width: 1.5px; background: var(--t-ruler-mark); }
.share__ruler-pin-halo { position: absolute; z-index: 2; top: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; border-radius: 50%; background: var(--t-pin-halo); }
.share__ruler-pin { position: absolute; z-index: 3; top: 50%; transform: translate(-50%, -50%); width: 15px; height: 15px; border-radius: 50%; background: var(--t-ruler-end); border: 2.4px solid var(--t-pin-line); box-sizing: border-box; }
.share__ruler-ticks { display: flex; justify-content: space-between; margin-top: 9px; font-size: 14px; font-weight: 600; color: var(--t-top-muted); }

/* Ticket Perforation */
.share__perf { position: relative; height: 22px; background: linear-gradient(to bottom, var(--t-top-1) 50%, var(--t-body) 50%); display: flex; align-items: center; }
.share__perf-line { width: 100%; margin: 0 18px; border-top: 1.5px dashed var(--t-perf); }
.share__notch { position: absolute; top: 50%; transform: translateY(-50%); width: 22px; height: 22px; border-radius: 50%; background: #f5f1e9; border: 1px solid var(--t-border); box-sizing: border-box; }
.share__notch--l { left: -12px; }
.share__notch--r { right: -12px; }

/* ============ TICKET BODY ============ */
.share__body { padding: 14px 22px 22px; }

/* A1: Donut + Bespoke Vector Icon Tiles */
.share__donut-row { display: flex; align-items: center; gap: 14px; padding: 2px 0 16px; border-bottom: 1px solid var(--t-rule); }
.share__donut-wrap { width: 124px; height: 124px; flex: none; }
.share__donut-img { display: block; width: 124px; height: 124px; }
.share__donut-stats { flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.share__donut-stats--two { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.share__dchip { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 112px; padding: 12px 6px; border-radius: 16px; background: var(--t-surface); border: 1px solid var(--t-surface-line); }
.share__dicon { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 6px; }
.share__dicon-svg { width: 16px; height: 16px; display: block; }
.share__dicon--ok { background: var(--t-ok-bg); }
.share__dicon--no { background: var(--t-no-bg); }
.share__dicon--bl { background: var(--t-bl-bg); }
.share__dval { font-size: 28px; font-weight: 700; color: var(--t-ink); line-height: 1.1; }
.share__donut-stats--two .share__dval { font-size: 32px; }
.share__dlbl { font-size: 15px; color: var(--t-muted); margin-top: 3px; }

/* A2: Segmented Bar */
.share__seg-wrap { padding: 2px 0 14px; border-bottom: 1px solid var(--t-rule); }
.share__seg-bar { display: flex; height: 10px; border-radius: 99px; overflow: hidden; gap: 3px; background: var(--t-bar-track); }
.share__seg-ok { background: var(--t-ok); border-radius: 99px; }
.share__seg-no { background: var(--t-no); border-radius: 99px; }
.share__seg-bl { background: var(--t-bl); border-radius: 99px; }
.share__seg-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 13px; }
.share__seg-item { display: inline-flex; align-items: baseline; gap: 7px; font-size: 16px; color: var(--t-muted); }
.share__seg-val { font-size: 22px; font-weight: 700; color: var(--t-ink); }
.share__seg-dot { align-self: center; width: 10px; height: 10px; border-radius: 50%; }
.share__seg-dot--ok { background: var(--t-ok); }
.share__seg-dot--no { background: var(--t-no); }
.share__seg-dot--bl { background: var(--t-bl); }

/* Repeat VS Row */
.share__vs-row { display: flex; align-items: baseline; gap: 10px; padding: 14px 0; border-bottom: 1px solid var(--t-rule); font-size: 16px; }
.share__vs-caption { color: var(--t-muted); font-weight: 500; }
.share__vs-scores { color: var(--t-ink); font-size: 18px; font-weight: 700; }
.share__vs-delta { margin-left: auto; font-size: 17px; font-weight: 700; color: var(--t-muted); }
.share__vs-delta--up { color: var(--t-ok-ink); }
.share__vs-delta--down { color: var(--t-no-ink); }

/* Section Header & Bespoke Micro-Icons */
.share__section { margin-top: 18px; }
.share__sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 11px; }
.share__sec-title-wrap { display: inline-flex; align-items: center; gap: 7px; }
.share__sec-icon { width: 18px; height: 18px; flex: none; display: block; }
.share__heading { color: var(--t-ink); font-family: FangYuan, Nunito, sans-serif; font-size: 20px; font-weight: 700; letter-spacing: .2px; }
.share__unit-legend { font-size: 13px; font-weight: 500; color: var(--t-subtle); }
.share__best-tag { display: inline-flex; align-items: center; gap: 5px; font-size: 16px; font-weight: 700; color: var(--t-bar-best); }
.share__star-icon { width: 13px; height: 13px; flex: none; display: block; }

/* A1 Score Card Mini Equalizer */
.share__eq-box { margin-top: 14px; padding: 14px 14px 14px; border-radius: 16px; background: var(--t-surface); border: 1px solid var(--t-surface-line); }
.share__eq-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13px; }
.share__eq-title { color: var(--t-ink); font-family: FangYuan, Nunito, sans-serif; font-size: 18px; font-weight: 700; }
.share__eq-bars { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; align-items: end; }
.share__eq-col { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.share__eq-pct { font-size: 15px; font-weight: 700; color: var(--t-muted); }
.share__eq-col--best .share__eq-pct { color: var(--t-bar-best); }
.share__eq-col--low .share__eq-pct { color: var(--t-subtle); }
.share__eq-track { width: 20px; height: 58px; border-radius: 99px; background: var(--t-bar-track); display: flex; align-items: flex-end; overflow: hidden; }
.share__eq-fill { width: 100%; border-radius: 99px; background: linear-gradient(180deg, var(--t-bar-fill-0) 0%, var(--t-bar-fill-1) 100%); }
.share__eq-col--best .share__eq-fill { background: linear-gradient(180deg, var(--t-bar-best-0) 0%, var(--t-bar-best-1) 100%); }
.share__eq-col--low .share__eq-fill { background: linear-gradient(180deg, var(--t-bar-low-0) 0%, var(--t-bar-low-1) 100%); }
.share__eq-lbl { font-size: 15px; font-weight: 600; color: var(--t-muted); }
.share__eq-col--best .share__eq-lbl { color: var(--t-bar-best); font-weight: 700; }

.share__radar-wrap { width: 100%; height: 306px; }
.share__radar { display: block; width: 100%; height: 100%; }

/* A1 Vertical Column Chart with Inline 80% Tag */
.share__vchart { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; padding: 15px 40px 15px 8px; border-radius: 18px; background: var(--t-surface); border: 1px solid var(--t-surface-line); }
.share__vchart-ref-row { position: absolute; left: 8px; right: 8px; top: 55px; display: flex; align-items: center; gap: 5px; pointer-events: none; }
.share__vchart-ref { flex: 1; border-top: 1px dashed var(--t-ref); }
.share__vchart-ref-tag { font-size: 12px; font-weight: 600; color: var(--t-subtle); line-height: 1; }
.share__vbar { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 5px; }
.share__vbar-pct { font-size: 18px; font-weight: 700; color: var(--t-ink); line-height: 1.1; }
.share__vbar-track { width: 28px; height: 116px; border-radius: 9px; background: var(--t-bar-track); display: flex; align-items: flex-end; overflow: hidden; }
.share__vbar-fill { width: 100%; border-radius: 9px; background: linear-gradient(180deg, var(--t-bar-fill-0) 0%, var(--t-bar-fill-1) 100%); }
.share__vbar--best .share__vbar-fill { background: linear-gradient(180deg, var(--t-bar-best-0) 0%, var(--t-bar-best-1) 100%); }
.share__vbar--best .share__vbar-pct { color: var(--t-bar-best); }
.share__vbar--low .share__vbar-fill { background: linear-gradient(180deg, var(--t-bar-low-0) 0%, var(--t-bar-low-1) 100%); }
.share__vbar-lbl { font-size: 16px; font-weight: 600; color: var(--t-ink); margin-top: 3px; }
.share__vbar--best .share__vbar-lbl { color: var(--t-bar-best); font-weight: 700; }
.share__vbar-raw { font-size: 14px; color: var(--t-subtle); white-space: nowrap; }

/* A2 3x2 Mini Rings Matrix */
.share__rings-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
.share__rings-grid--flush { margin-top: 0; }
.share__ring-tile { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 6px 13px; border-radius: 16px; background: var(--t-surface); border: 1px solid var(--t-surface-line); }
.share__ring-tile--best { background: var(--t-best-bg); border-color: var(--t-best-line); }
.share__ring-img { width: 82px; height: 82px; display: block; }
.share__ring-name { font-size: 16px; font-weight: 700; color: var(--t-ink); margin-top: 4px; }
.share__ring-tile--best .share__ring-name { color: var(--t-bar-best); }
.share__ring-raw { font-size: 15px; color: var(--t-subtle); white-space: nowrap; }

/* Timing */
.share__timing { display: flex; flex-direction: column; gap: 6px; padding-top: 14px; border-top: 1px solid var(--t-rule); }
.share__timing-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
.share__timing-total { font-size: 15px; color: var(--t-muted); }
.share__timing-row { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 10px; align-items: center; min-height: 36px; border-top: 1px solid var(--t-rule); color: var(--t-muted); font-size: 16px; }
.share__timing-row text:last-child { text-align: right; font-weight: 700; color: var(--t-ink); }

/* Clean QR Footer */
.share__footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--t-rule); }
.share__brand { display: flex; align-items: center; gap: 12px; }
.share__brand-logo { width: 44px; height: 44px; border-radius: 11px; flex: none; }
.share__brand-copy { display: flex; flex-direction: column; gap: 3px; }
.share__brand-name { font-family: FangYuan, Nunito, sans-serif; font-size: 21px; font-weight: 700; color: var(--t-ink); line-height: 1.2; letter-spacing: .2px; }
.share__brand-sub { font-size: 15px; color: var(--t-subtle); line-height: 1.2; }
.share__qr-halo { padding: 3px; border-radius: 50%; border: 2px solid var(--t-qr-halo); flex: none; }
.share__qr-wrap { width: 76px; height: 76px; padding: 3px; border-radius: 50%; background: var(--t-qr-bg); border: 1px solid var(--t-qr-line); box-sizing: border-box; overflow: hidden; }
.share__qr { display: block; width: 100%; height: 100%; border-radius: 50%; }

/* Offscreen canvases */
.share__offscreen { position: absolute; left: -9999px; top: 0; pointer-events: none; }
.share__canvas { width: 1px; height: 1px; }
.share__radar-canvas { width: 406px; height: 306px; }
.share__donut-canvas { width: 124px; height: 124px; }
.share__ring-canvas { width: 82px; height: 82px; }

/* Fixed Footer Actions */
.share__actions { display: flex; flex: none; align-items: center; gap: 12px; padding: 14px 20px calc(14px + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid #efe7d9; }
.share__actions .btn { min-height: 46px; }
.share__actions .btn[disabled] { opacity: .55; }
.share__invite-wrap { position: relative; flex: none; }
.share__invite { width: auto !important; padding: 0 18px; border: 1px solid #e4d9c6; color: #241e17; background: #fffdf8; white-space: nowrap; }
.share__reward-badge { position: absolute; top: -9px; right: 10px; z-index: 2; display: inline-flex; align-items: center; gap: 3px; height: 20px; padding: 0 7px 0 5px; border-radius: 999px; background: #f3e4c3; border: 1px solid #e0cba0; pointer-events: none; box-sizing: border-box; }
.share__reward-badge-icon { width: 12px; height: 12px; flex: none; display: block; }
.share__reward-badge-num { font-size: 11px; font-weight: 700; line-height: 1; color: #7c5619; }

@media (max-width: 350px) {
  .share__studio { padding-inline: 14px; }
  .share__actions { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); gap: 9px; }
  .share__invite { padding-inline: 14px; }
  .share__reward-badge { top: -8px; right: 8px; height: 18px; padding: 0 6px 0 4px; }
  .share__reward-badge-icon { width: 11px; height: 11px; }
  .share__reward-badge-num { font-size: 10.5px; }
  .share__mode { font-size: 12px; }
  .share__style-chip { font-size: 11px; gap: 4px; padding: 0 4px; }
}
