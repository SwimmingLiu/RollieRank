<view class="screen screen--plain share">
  <rr-nav title="成绩分享" />
  <view wx:if="{{loading}}" class="loading">正在准备分享图…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <block wx:else>
    <view class="share__modes">
      <button wx:for="{{modes}}" wx:key="key" class="share__mode {{mode === item.key ? 'share__mode--on' : ''}}" data-key="{{item.key}}" bindtap="setMode">{{item.label}}</button>
    </view>
    <scroll-view class="share__preview" scroll-y scroll-top="{{previewTop}}">
      <canvas type="2d" id="shareCanvas" class="share__canvas" style="width: {{previewWidth}}px; height: {{previewHeight}}px;" />
    </scroll-view>
    <view class="share__actions">
      <button class="btn btn--primary" bindtap="save" disabled="{{!ready || saving}}">
        <image class="btn__icon" src="{{uiBase}}/download-light.svg" mode="aspectFit" />保存海报
      </button>
      <button class="btn share__invite" open-type="share"><image class="btn__icon" src="{{uiBase}}/share.svg" mode="aspectFit" />邀请好友</button>
    </view>
  </block>
</view>
