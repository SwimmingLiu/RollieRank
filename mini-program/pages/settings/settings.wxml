<view class="screen screen--plain">
  <rr-nav title="设置" />

  <view class="card set__block">
    <text class="set__label">昵称</text>
    <view class="row row--gap set__row">
      <input class="set__input grow" value="{{name}}" maxlength="12" bindinput="onName" placeholder="卷友" />
      <view class="chip chip--on" bindtap="saveName">保存</view>
    </view>
    <text class="text-xs">昵称会随正式成绩出现在同卷榜与讨论区。</text>
  </view>

  <view class="card set__block">
    <view class="row row--between">
      <text class="set__label">本机身份</text>
      <text class="text-xs" bindtap="copyId">复制</text>
    </view>
    <text class="set__id ellipsis">{{guestId}}</text>
    <text class="text-xs">更换手机或清除小程序数据前请先备份；身份丢失后原记录不再归属。</text>
  </view>

  <view class="card set__block">
    <text class="set__label">记录</text>
    <view class="set__action" bindtap="backup">
      <text>备份到剪贴板</text>
      <text class="text-xs">{{count}} 份记录</text>
    </view>
    <view class="set__action" bindtap="restore">
      <text>从剪贴板恢复</text>
      <image class="set__icon" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
    </view>
    <view class="set__action set__action--danger" bindtap="clearAll">
      <text>删除全部记录</text>
      <text class="text-xs">{{deleting ? '处理中…' : ''}}</text>
    </view>
  </view>

  <view class="card set__block" bindtap="about">
    <view class="set__action">
      <text>关于卷卷小榜</text>
      <image class="set__icon" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
    </view>
  </view>
</view>
