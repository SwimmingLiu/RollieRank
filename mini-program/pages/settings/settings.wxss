.set__card { display: block; margin: 14px 22px; padding: 16px; border: 1px solid #e9dfce; border-radius: 20px; background: var(--card); box-shadow: 0 3px 0 #eae1d0; }
.set__label { display: block; margin-bottom: 10px; font-weight: 650; }
.set__row { display: flex; align-items: center; gap: 10px; }
.set__input { flex: 1; min-width: 0; height: 44px; padding: 0 12px; border: 1px solid #e9dfce; border-radius: 12px; background: var(--paper); }
.set__save { display: flex; align-items: center; justify-content: center; flex: none; width: auto !important; min-width: 64px; height: 44px; padding: 0 13px; border-radius: 12px; background: #2d2c25; color: #fffaf0; }
@media (max-width: 350px) { .set__card { margin-inline: 16px; } }
