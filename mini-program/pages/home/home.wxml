<view class="screen screen--tab" style="padding-top: {{safeTop}}px;">
  <view class="home__head">
    <image class="home__logo" src="{{asset.logo}}" mode="aspectFit" />
    <text class="home__brand">卷卷小榜</text>
  </view>

  <view wx:if="{{loading}}" class="loading">正在准备套卷…</view>
  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
    <view class="chip" bindtap="retry">重新读取</view>
  </view>

  <block wx:else>
    <view class="section-title home__section">选卷估分</view>
    <view class="home__grid">
      <view wx:for="{{institutions}}" wx:key="name" class="card press home__inst" data-name="{{item.name}}" bindtap="openInstitution">
        <image wx:if="{{item.logo}}" class="home__inst-logo" src="{{asset[item.logo]}}" mode="aspectFit" />
        <text class="home__inst-name">{{item.label || item.name}}</text>
        <image class="home__inst-arrow" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="card press home__timer" bindtap="openTimer">
      <view class="home__timer-icon">
        <image class="home__timer-clock" src="{{uiBase}}/clock.svg" mode="aspectFit" />
      </view>
      <view class="grow stack">
        <text class="home__timer-title">做题计时</text>
        <text class="text-xs">整卷或模块计划 · 自定义</text>
      </view>
      <view class="home__timer-play">
        <image src="{{uiBase}}/play.svg" mode="aspectFit" />
      </view>
    </view>

    <block wx:if="{{recent.length}}">
      <view class="section-title home__section row row--between">
        <text>最近练习</text>
        <text class="text-sm" bindtap="openRecords">全部</text>
      </view>
      <view class="home__recent">
        <view wx:for="{{recent}}" wx:key="id" class="card press home__recent-card" data-id="{{item.id}}" data-draft="{{item.draft}}" data-version="{{item.versionId}}" bindtap="openRecent">
          <view class="row row--between">
            <view class="stack grow">
              <text class="text-sm ellipsis">{{item.detail}}</text>
              <text class="home__recent-title ellipsis">{{item.title}}</text>
            </view>
            <text wx:if="{{item.draft}}" class="num home__recent-progress">{{item.progress}}</text>
            <text wx:else class="num home__recent-score">{{item.scoreText}}</text>
          </view>
          <view class="row row--between home__recent-meta">
            <text wx:if="{{item.draft}}" class="text-xs">录入中</text>
            <text wx:else class="text-xs">正确 {{item.correct}} · 错误 {{item.wrong}}</text>
            <text class="text-xs">{{item.draft ? '继续录入' : '看成绩'}}</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="empty">
      <image class="empty__icon" src="{{uiBase}}/book.svg" mode="aspectFit" />
      <text>还没有练习记录</text>
    </view>
  </block>

  <rr-tabbar active="home" />
</view>
