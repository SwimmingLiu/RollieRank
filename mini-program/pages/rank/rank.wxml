<view class="screen screen--plain">
  <rr-nav title="同卷榜" action-icon="help" action-label="排名口径" bind:action="help" />
  <view wx:if="{{loading}}" class="loading">正在读取榜单…</view>
  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
    <button class="chip" bindtap="load">重新读取</button>
  </view>

  <view wx:else class="rank">
    <view class="rank__identity">
      <image wx:if="{{logo}}" src="{{logo}}" mode="aspectFit" />
      <text class="rank__publisher">{{publisher}}</text><text class="grow">{{identity}}</text>
    </view>
    <scroll-view class="rank__dimensions" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="rank__dimension-row">
        <button wx:for="{{dimensions}}" wx:key="key" class="rank__dimension {{dimension === item.key ? 'rank__dimension--on' : ''}}" data-key="{{item.key}}" bindtap="setDimension">{{item.label}}</button>
      </view>
    </scroll-view>
    <view class="rank__scope">
      <button wx:for="{{scopes}}" wx:key="key" class="rank__scope-tab {{scope === item.key ? 'rank__scope-tab--on' : ''}}" data-key="{{item.key}}" bindtap="setScope">
        <image src="{{uiBase}}/{{item.icon}}.svg" mode="aspectFit" />{{item.label}}
      </button>
      <button class="rank__scope-tab" bindtap="pickPosition"><image src="{{uiBase}}/search.svg" mode="aspectFit" />换岗</button>
    </view>
    <view class="rank__position">
      <view class="rank__position-icon"><image src="{{uiBase}}/{{scope === 'national' ? 'globe' : 'map-pin'}}.svg" mode="aspectFit" /></view>
      <view class="stack grow">
        <text class="rank__position-title">{{scope === 'national' ? '全国考生' : position.label}}</text>
        <text wx:if="{{scope === 'national'}}" class="rank__muted">不限报考岗位</text>
      </view>
      <view class="rank__count"><image src="{{uiBase}}/users.svg" mode="aspectFit" />{{count}}</view>
    </view>

    <view wx:if="{{winners.length}}" class="rank__podium">
      <button wx:for="{{winners}}" wx:key="publicId" class="rank__podium-card rank__podium-card--{{index + 1}}" bindtap="openResult" data-id="{{item.publicId}}">
        <view class="rank__card-top">
          <text>{{item.rankText}}</text><image wx:if="{{index === 0}}" src="{{uiBase}}/trophy.svg" mode="aspectFit" />
        </view>
        <view class="rank__podium-avatar">{{item.initials}}</view>
        <text class="rank__podium-name">{{item.name}}</text>
        <text class="display-num rank__podium-score {{item.scoreText.length > 5 ? 'rank__podium-score--wide' : ''}}">{{item.scoreText}}</text>
        <text class="rank__muted">分</text>
        <text class="rank__muted">超越 {{item.surpassed}}</text>
      </button>
    </view>

    <view class="rank__list">
      <button wx:for="{{otherRows}}" wx:key="publicId" class="rank__row" bindtap="openResult" data-id="{{item.publicId}}">
        <text class="rank__row-rank">{{item.rankText}}</text>
        <view class="rank__list-avatar">{{item.initials}}</view>
        <text class="rank__row-name grow">{{item.name}}{{item.isMe ? '（我）' : ''}}</text>
        <text class="rank__row-score">{{item.scoreText}}</text>
      </button>
    </view>
    <view wx:if="{{!winners.length}}" class="empty">这份卷还没有人参与</view>
  </view>
</view>
