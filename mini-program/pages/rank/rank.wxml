<page-meta page-style="overflow: hidden;" />
<view class="screen screen--plain">
  <rr-nav title="同卷榜" leading="{{true}}" action-icon="help" action-label="榜单规则" bind:action="help" />
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-scroll__body--plain">
  <view wx:if="{{loading}}" class="loading">正在读取榜单…</view>
  <view wx:elif="{{error}}" class="state-wrap">
    <view class="state-card">
      <view class="state-card__badge">
        <image class="state-card__icon" src="/assets/ui/warn-ochre.svg" mode="aspectFit" />
      </view>
      <text class="state-card__title">暂时无法连接</text>
      <text class="state-card__desc">{{error}}</text>
      <button class="state-card__btn" bindtap="load" hover-class="press">
        <image class="state-card__btn-icon" src="/assets/ui/refresh-light.svg" mode="aspectFit" />
        <text>重新读取</text>
      </button>
    </view>
  </view>

  <view wx:else class="rank">
    <!-- 无框纸本报头：机构与套卷信息直接落纸 -->
    <view class="rank__masthead">
      <image wx:if="{{logo}}" class="rank__masthead-logo" src="{{logo}}" mode="aspectFit" />
      <text class="rank__publisher">{{publisher}}</text>
      <text class="rank__masthead-dot">·</text>
      <text class="rank__identity-text grow ellipsis">{{identity}}</text>
    </view>

    <!-- 报刊细底线维度栏：克制赭石指示条 -->
    <scroll-view class="rank__dimensions" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="rank__dimension-row">
        <button wx:for="{{dimensions}}" wx:key="key" class="rank__dimension {{dimension === item.key ? 'rank__dimension--on' : ''}}" data-key="{{item.key}}" bindtap="setDimension">
          <text>{{item.label}}</text>
          <view wx:if="{{dimension === item.key}}" class="rank__dimension-bar"></view>
        </button>
      </view>
    </scroll-view>

    <!-- 范围切换与当前岗位合一纸卡 -->
    <view class="rank__scope-card">
      <view class="rank__scope">
        <button wx:for="{{scopes}}" wx:key="key" class="rank__scope-tab {{scope === item.key ? 'rank__scope-tab--on' : ''}}" data-key="{{item.key}}" bindtap="setScope" aria-label="{{item.name}}" aria-pressed="{{scope === item.key}}">
          <rr-icon name="{{scope === item.key ? item.activeIcon : item.icon}}" size="{{15}}" />
          <text>{{item.short}}</text>
        </button>
      </view>
      <button class="rank__position {{scope === 'nationwide' ? 'rank__position--static' : ''}}" bindtap="changePosition" disabled="{{scope === 'nationwide'}}" hover-class="{{scope === 'nationwide' ? 'none' : 'press'}}">
        <view wx:if="{{scope === 'nationwide'}}" class="rank__position-globe">
          <rr-icon name="rank-globe-on" size="{{15}}" />
        </view>
        <view wx:else class="rank__position-bar"></view>
        <view class="rank__position-title grow ellipsis">{{scopeLabel}}</view>
        <view class="rank__count">
          <rr-icon name="rank-users" size="{{13}}" />
          <text class="num">{{count}}人</text>
        </view>
        <rr-icon wx:if="{{scope !== 'nationwide'}}" name="rank-chevron" size="{{13}}" />
      </button>
    </view>

    <!-- 未设置微信资料时的温和一步引导 -->
    <button wx:if="{{!hasWechatProfile && (self || winners.length)}}" class="rank__profile-tip" bindtap="openProfileSheet" hover-class="press">
      <image class="rank__profile-avatar" src="{{defaultAvatar}}" mode="aspectFill" />
      <text class="grow ellipsis">同步微信头像与昵称，榜单实时展示</text>
      <rr-icon name="rank-chevron" size="{{13}}" />
    </button>

    <!-- 领奖台 / 单人叠纸主角卡组件 -->
    <rr-rank-podium wx:if="{{winners.length}}" winners="{{winners}}" bind:select="openResult" />

    <!-- 第四名及以后列表组件 -->
    <view wx:if="{{self || otherRows.length}}" class="rank__list">
      <rr-rank-row wx:if="{{self}}" item="{{self}}" variant="self" bind:select="openResult" />
      <view wx:if="{{otherRows.length}}" class="rank__list-card">
        <rr-rank-row wx:for="{{otherRows}}" wx:key="publicId" item="{{item}}" variant="row" is-last="{{index === otherRows.length - 1}}" bind:select="openResult" />
      </view>
    </view>

    <button wx:if="{{canLoadMore}}" class="rank__more" hover-class="press" bindtap="loadMore">继续加载</button>

    <view wx:if="{{!winners.length}}" class="rank__empty">
      <view class="rank__empty-badge">
        <rr-icon name="trophy-ochre" size="{{20}}" />
      </view>
      <text class="rank__empty-text">{{scope === 'nationwide' ? '这份卷还没有人参与' : '该岗位暂无考生参与'}}</text>
    </view>
  </view>
  </view>
  </scroll-view>
  <rr-position-picker wx:if="{{positionMode}}" mode="{{positionMode}}" bind:dismiss="closePosition" bind:selection="selectPosition" />
  <rr-profile-sheet wx:if="{{profileSheetOpen}}" bind:dismiss="closeProfileSheet" bind:saved="onProfileSaved" />
</view>
