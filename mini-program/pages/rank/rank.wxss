.rank { display: flex; flex-direction: column; gap: 10px; padding: 6px 18px 28px; }

/* 无框纸本报头 */
.rank__masthead { display: flex; align-items: center; gap: 6px; min-height: 28px; padding: 0 2px; font-size: 12px; color: #7e6f5b; }
.rank__masthead-logo { width: 20px; height: 20px; flex: none; }
.rank__publisher { font-weight: 700; color: #3a3228; flex: none; }
.rank__masthead-dot { color: #c4b59f; flex: none; }
.rank__identity-text { color: #847561; }

/* 报刊细底线维度栏 */
.rank__dimensions { border-top: 1px solid #ece3d4; border-bottom: 1px solid #ece3d4; }
.rank__dimension-row { display: flex; align-items: stretch; min-width: 100%; }
.rank__dimension {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  width: auto !important;
  margin: 0 !important;
  padding: 0 4px;
  min-width: 38px;
  min-height: 38px;
  color: #867865;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
}
.rank__dimension--on { color: #241f18; font-weight: 700; }
.rank__dimension-bar {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 18px;
  height: 2.5px;
  border-radius: 999px;
  background: #b98a3e;
}

/* 范围切换与当前岗位合一纸卡 */
.rank__scope-card {
  display: flex;
  flex-direction: column;
  border: 1px solid #e9dfd0;
  border-radius: 17px;
  background: #fffdf8;
  box-shadow: 0 2px 0 #eee5d6;
  overflow: hidden;
}
.rank__scope { display: flex; padding: 4px; gap: 3px; background: #f2ece1; border-bottom: 1px solid #ede4d5; }
.rank__scope-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  flex: 1;
  width: 0 !important;
  margin: 0 !important;
  min-height: 36px;
  border-radius: 11px;
  color: #847460;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
}
.rank__scope-tab--on {
  background: #fffdf8;
  color: #2b251d;
  font-weight: 650;
  box-shadow: 0 1px 4px rgba(91, 74, 49, 0.10);
}

.rank__position {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100% !important;
  margin: 0 !important;
  min-height: 48px;
  padding: 9px 12px;
  background: #fffdf8;
  text-align: left;
}
.rank__position--static { opacity: 1; }
.rank__position-bar { width: 3px; height: 15px; border-radius: 999px; background: #b98a3e; flex: none; }
.rank__position-globe { display: flex; align-items: center; justify-content: center; flex: none; }
.rank__position-title { display: block; text-align: left; font-size: 13px; line-height: 1.35; color: #3d3428; font-weight: 600; }

.rank__count {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 25px;
  padding: 0 8px;
  border-radius: 999px;
  background: #f3ecdf;
  color: #77654d;
  font-size: 11px;
  font-weight: 600;
  flex: none;
  white-space: nowrap;
}

.rank__profile-tip {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100% !important;
  min-height: 44px;
  padding: 6px 12px;
  border: 1px solid #e6d8be;
  border-radius: 14px;
  background: #fbf3e2;
  color: #6a522d;
  font-size: 12px;
  font-weight: 500;
  text-align: left;
}
.rank__profile-avatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1.5px solid #fffdf8;
  background: #fffdf8;
  flex: none;
}

/* 第四名及以后列表容器 */
.rank__list { display: flex; flex-direction: column; gap: 10px; margin-top: 2px; }
.rank__list-card {
  display: flex;
  flex-direction: column;
  background: #fffdf8;
  border: 1px solid #ece3d4;
  border-radius: 19px;
  padding: 3px 13px;
  box-shadow: 0 2px 0 #efe6d7;
}

.rank__more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin: 2px 0 0 !important;
  min-height: 44px;
  border-radius: 14px;
  border: 1px solid #eae0d0;
  background: #fffdf8;
  color: #7c674c;
  font-size: 13px;
  font-weight: 600;
}

/* 空状态纸卡 */
.rank__empty {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 4px;
  padding: 16px;
  border: 1px solid #eae0cf;
  border-radius: 18px;
  background: #fffdf8;
  box-shadow: 0 2px 0 #eee5d6;
}
.rank__empty-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: #f5ead4;
  border: 1px solid #ead8b5;
  flex: none;
}
.rank__empty-text { font-size: 13px; font-weight: 600; color: #675844; }

@media (max-width: 350px) {
  .rank { padding: 6px 14px 24px; gap: 9px; }
  .rank__dimension { min-width: 36px; padding: 0 2px; font-size: 11px; }
  .rank__position { gap: 7px; padding: 8px 10px; }
  .rank__position-title { font-size: 12px; }
}
