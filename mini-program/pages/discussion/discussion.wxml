<view class="screen">
  <rr-nav title="本卷交流" back="{{true}}" />

  <view wx:if="{{loading}}" class="loading">正在读取讨论…</view>
  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <view class="disc__head" aria-label="共 {{total}} 条评论">
      <view class="disc__caption"><image src="{{uiBase}}/comment.svg" mode="aspectFit" /></view>
      <text class="disc__count">{{total}}</text>
    </view>

    <view class="disc__list">
      <view wx:for="{{comments}}" wx:key="id" class="card disc__comment">
        <text class="disc__badge">{{item.initials}}</text>
        <view class="grow">
          <text class="disc__name">{{item.author.name}}</text>
          <text wx:if="{{item.target}}" class="text-xs disc__target">回复 {{item.target}}</text>
          <text wx:if="{{item.text}}" class="disc__text">{{item.text}}</text>
          <view wx:if="{{item.links.length}}" class="disc__links">
            <text wx:for="{{item.links}}" wx:for-item="link" wx:key="*this" data-link="{{link}}" bindtap="copyExternalLink">{{link}}</text>
          </view>
          <view wx:if="{{item.images.length}}" class="disc__images">
            <image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" class="disc__image" src="{{photo}}" mode="aspectFill" data-src="{{photo}}" bindtap="previewImage" />
          </view>
          <view class="disc__actions">
            <text class="disc__time">{{item.timeText}}</text>
            <button class="icon-button" data-id="{{item.id}}" data-name="{{item.author.name}}" bindtap="startReply" aria-label="回复 {{item.author.name}}"><image src="{{uiBase}}/comment.svg" mode="aspectFit" /></button>
            <button class="disc__action disc__like {{item.likedByMe ? 'disc__like--on' : ''}}" data-id="{{item.id}}" data-liked="{{item.likedByMe}}" bindtap="toggleLike" aria-label="{{item.likedByMe ? '取消点赞' : '点赞'}}">
              <image class="disc__action-icon" src="{{uiBase}}/like.svg" mode="aspectFit" />
              <text>{{item.likeCount || 0}}</text>
            </button>
          </view>
          <button wx:if="{{item.replyCount}}" class="disc__action" data-id="{{item.id}}" bindtap="toggleReplies"
            aria-expanded="{{expanded === item.id}}" aria-label="{{expanded === item.id ? '收起回复' : '展开 ' + item.replyCount + ' 条回复'}}">
            <image class="disc__action-icon {{expanded === item.id ? 'disc__reply-open' : ''}}" src="{{uiBase}}/chevron-down.svg" mode="aspectFit" /><text>{{item.replyCount}}</text>
          </button>
          <view wx:if="{{expanded === item.id}}" class="disc__replies">
            <view wx:for="{{replies}}" wx:for-item="reply" wx:key="id" class="disc__reply">
              <text class="disc__name">{{reply.author.name}}</text>
              <text wx:if="{{reply.target}}" class="text-xs disc__target">回复 {{reply.target}}</text>
              <text class="disc__text">{{reply.text}}</text>
              <button class="icon-button" data-id="{{reply.id}}" data-root="{{item.id}}" data-name="{{reply.author.name}}" bindtap="startReply" aria-label="回复 {{reply.author.name}}"><image src="{{uiBase}}/comment.svg" mode="aspectFit" /></button>
              <view wx:if="{{reply.links.length}}" class="disc__links"><text wx:for="{{reply.links}}" wx:for-item="link" wx:key="*this" data-link="{{link}}" bindtap="copyExternalLink">{{link}}</text></view>
              <view wx:if="{{reply.images.length}}" class="disc__images"><image wx:for="{{reply.images}}" wx:for-item="photo" wx:key="*this" class="disc__image" src="{{photo}}" mode="aspectFill" data-src="{{photo}}" bindtap="previewImage" /></view>
            </view>
            <button wx:if="{{replyCursor}}" class="disc__action" bindtap="moreReplies">更多回复</button>
          </view>
        </view>
      </view>

      <view wx:if="{{!comments.length}}" class="disc__empty">
        <image class="disc__empty-icon" src="{{uiBase}}/comment.svg" mode="aspectFit" />
        <text>暂无评论</text>
      </view>
    </view>


    <view class="disc__footer" style="bottom: {{keyboardHeight}}px;">
      <view wx:if="{{replyTarget}}" class="disc__reply-bar">
        <text class="grow ellipsis">回复 {{replyTarget.name}}</text>
        <button class="icon-button" bindtap="cancelReply" aria-label="取消回复"><image src="{{uiBase}}/close.svg" mode="aspectFit" /></button>
      </view>
      <view wx:if="{{images.length}}" class="disc__images disc__pending">
        <view wx:for="{{images}}" wx:key="path" class="disc__attachment">
          <image src="{{item.path}}" mode="aspectFill" />
          <button class="disc__remove" data-index="{{index}}" bindtap="removeImage" aria-label="移除照片">×</button>
        </view>
      </view>
      <view class="disc__composer">
        <text class="disc__badge">{{initials}}</text>
        <textarea class="disc__input grow" auto-height maxlength="2000" value="{{replyTarget ? replyDraft : draft}}" placeholder="{{replyTarget ? '回复' : '评论'}}" placeholder-class="disc__placeholder" bindinput="onComposerInput" confirm-type="send" bindconfirm="sendComposer" adjust-position="{{false}}" bindkeyboardheightchange="keyboard"></textarea>
        <button wx:if="{{!(replyTarget ? replyDraft : draft) && !images.length}}" class="disc__compose-icon" bindtap="pickImage" aria-label="添加照片">
          <image src="{{uiBase}}/image.svg" mode="aspectFit" />
        </button>
        <block wx:else>
          <button wx:if="{{images.length < 3}}" class="disc__compose-icon" bindtap="pickImage" aria-label="添加照片">
            <image src="{{uiBase}}/image.svg" mode="aspectFit" />
          </button>
          <button class="disc__compose-icon disc__send" bindtap="sendComposer" disabled="{{sending}}" aria-label="发送">
            <image src="{{uiBase}}/send-light.svg" mode="aspectFit" />
          </button>
        </block>
      </view>
    </view>
  </block>
</view>
