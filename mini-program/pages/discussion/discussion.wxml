<page-meta page-style="overflow: hidden;" />
<view class="screen">
  <rr-nav title="本卷交流" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" lower-threshold="120" bindscrolltolower="onReachBottom">
  <view wx:if="{{loading}}" class="loading">正在读取讨论…</view>
  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
    <button class="chip" bindtap="retry">重新读取</button>
  </view>

  <view wx:else class="disc__list {{replyTarget || images.length || !hasWechatProfile ? 'disc__list--extended' : ''}}" aria-label="共 {{total}} 条评论">
      <view wx:for="{{comments}}" wx:key="id" class="disc__comment">
        <image class="disc__avatar" src="{{item.avatar}}" mode="aspectFill" aria-label="{{item.author.name}}的头像" />
        <view class="grow">
          <text class="disc__name">{{item.author.name}}<text wx:if="{{item.moderationText}}" class="disc__mod-badge">{{item.moderationText}}</text></text>
          <text wx:if="{{item.target}}" class="text-xs disc__target">回复 {{item.target}}</text>
          <text wx:if="{{item.text}}" class="disc__text">{{item.text}}</text>
          <view wx:if="{{item.links.length}}" class="disc__links">
            <text wx:for="{{item.links}}" wx:for-item="link" wx:key="*this" data-link="{{link}}" bindtap="copyExternalLink">{{link}}</text>
          </view>
          <view wx:if="{{item.images.length}}" class="disc__images">
            <image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" class="disc__image" src="{{photo}}" mode="aspectFill" data-src="{{photo}}" bindtap="previewImage" />
          </view>
          <view class="disc__actions">
            <view class="disc__meta">
              <text class="disc__time">{{item.timeText}}</text>
              <text class="disc__meta-dot">·</text>
              <button class="disc__reply-action" data-id="{{item.id}}" data-name="{{item.author.name}}" bindtap="startReply" aria-label="回复 {{item.author.name}}">回复</button>
            </view>
            <button class="disc__like {{item.likedByMe ? 'disc__like--on' : ''}}" data-id="{{item.id}}" data-liked="{{item.likedByMe}}" bindtap="toggleLike" aria-label="{{item.likedByMe ? '取消点赞' : '点赞'}}">
              <image src="{{uiBase}}/{{item.likedByMe ? 'like-on' : 'like'}}.svg" mode="aspectFit" />
              <text wx:if="{{item.likeCount}}">{{item.likeCount}}</text>
            </button>
          </view>
          <button wx:if="{{item.replyCount}}" class="disc__expand" data-id="{{item.id}}" bindtap="toggleReplies"
            aria-expanded="{{expandedReplies[item.id]}}" aria-label="{{expandedReplies[item.id] ? '收起回复' : '展开 ' + item.replyCount + ' 条回复'}}">
            <view class="disc__expand-line"></view>
            <text>{{expandedReplies[item.id] ? '收起' : '展开 ' + item.replyCount + ' 条回复'}}</text>
            <image class="{{expandedReplies[item.id] ? 'disc__reply-open' : ''}}" src="{{uiBase}}/chevron-down.svg" mode="aspectFit" />
          </button>
          <view wx:if="{{expandedReplies[item.id]}}" class="disc__replies">
            <view wx:for="{{replyByRoot[item.id]}}" wx:for-item="reply" wx:key="id" class="disc__reply">
              <image class="disc__avatar disc__avatar--reply" src="{{reply.avatar}}" mode="aspectFill" aria-label="{{reply.author.name}}的头像" />
              <view class="grow">
              <text class="disc__name">{{reply.author.name}}</text>
              <text wx:if="{{reply.target}}" class="text-xs disc__target">回复 {{reply.target}}</text>
              <text class="disc__text">{{reply.text}}</text>
              <view wx:if="{{reply.links.length}}" class="disc__links"><text wx:for="{{reply.links}}" wx:for-item="link" wx:key="*this" data-link="{{link}}" bindtap="copyExternalLink">{{link}}</text></view>
              <view wx:if="{{reply.images.length}}" class="disc__images"><image wx:for="{{reply.images}}" wx:for-item="photo" wx:key="*this" class="disc__image" src="{{photo}}" mode="aspectFill" data-src="{{photo}}" bindtap="previewImage" /></view>
              <view class="disc__reply-meta">
                <text>{{reply.timeText}}</text><text class="disc__meta-dot">·</text>
                <button class="disc__reply-action" data-id="{{reply.id}}" data-root="{{item.id}}" data-name="{{reply.author.name}}" bindtap="startReply" aria-label="回复 {{reply.author.name}}">回复</button>
                <button class="disc__like {{reply.likedByMe ? 'disc__like--on' : ''}}" data-id="{{reply.id}}" data-liked="{{reply.likedByMe}}" bindtap="toggleLike" aria-label="{{reply.likedByMe ? '取消点赞' : '点赞'}}">
                  <image src="{{uiBase}}/{{reply.likedByMe ? 'like-on' : 'like'}}.svg" mode="aspectFit" />
                  <text wx:if="{{reply.likeCount}}">{{reply.likeCount}}</text>
                </button>
              </view>
              </view>
            </view>
            <button wx:if="{{replyCursors[item.id]}}" class="disc__expand" data-root="{{item.id}}" bindtap="moreReplies">更多回复</button>
          </view>
        </view>
      </view>

      <view wx:if="{{!comments.length}}" class="disc__empty">
        <image class="disc__empty-icon" src="{{uiBase}}/comment.svg" mode="aspectFit" />
        <text>暂无评论</text>
      </view>
  </view>
  </scroll-view>

    <view wx:if="{{!loading && !error}}" class="disc__footer" style="bottom: {{keyboardHeight}}px;">
      <button wx:if="{{!hasWechatProfile && !replyTarget}}" class="disc__profile-tip" bindtap="openProfile">
        <text class="grow ellipsis">同步微信头像与昵称，评论区实时展示</text>
        <image src="{{uiBase}}/chevron.svg" mode="aspectFit" />
      </button>
      <view wx:if="{{replyTarget}}" class="disc__reply-bar">
        <text class="grow ellipsis">回复 {{replyTarget.name}}</text>
        <button class="icon-button" bindtap="cancelReply" aria-label="取消回复"><image src="{{uiBase}}/close.svg" mode="aspectFit" /></button>
      </view>
      <view wx:if="{{images.length}}" class="disc__images disc__pending">
        <view wx:for="{{images}}" wx:key="path" class="disc__attachment">
          <image src="{{item.path}}" mode="aspectFill" />
          <button class="disc__remove" data-index="{{index}}" bindtap="removeImage" aria-label="移除照片">×</button>
        </view>
      </view>
      <view class="disc__composer">
        <textarea class="disc__input grow" auto-height maxlength="2000" value="{{replyTarget ? replyDraft : draft}}" placeholder="{{replyTarget ? '回复 ' + replyTarget.name : '说点什么…'}}" placeholder-class="disc__placeholder" focus="{{composerFocus}}" bindinput="onComposerInput" bindblur="onComposerBlur" confirm-type="send" bindconfirm="sendComposer" adjust-position="{{false}}" bindkeyboardheightchange="keyboard"></textarea>
        <button wx:if="{{images.length < 3}}" class="disc__compose-icon" bindtap="pickImage" aria-label="添加照片">
          <image src="{{uiBase}}/image.svg" mode="aspectFit" />
        </button>
        <button class="disc__compose-icon disc__send {{canSend ? 'disc__send--ready' : ''}}" bindtap="sendComposer" disabled="{{sending}}" aria-label="发送">
          <image src="{{uiBase}}/{{canSend ? 'send-light' : 'send'}}.svg" mode="aspectFit" />
        </button>
      </view>
    </view>
</view>
