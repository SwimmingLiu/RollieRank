<view class="screen">
  <rr-nav title="试卷讨论" back="{{true}}" />

  <view wx:if="{{loading}}" class="loading">正在读取讨论…</view>
  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <view class="disc__head">
      <text class="text-sm ellipsis">{{title}}</text>
      <text class="text-xs">{{total}} 条评论</text>
    </view>

    <view class="disc__list">
      <view wx:for="{{comments}}" wx:key="id" class="card disc__comment">
        <view class="row disc__meta">
          <image class="disc__avatar" src="{{item.avatar}}" mode="aspectFit" />
          <view class="stack grow">
            <text class="disc__name">{{item.author.name}}</text>
            <text class="text-xs">{{item.timeText}}</text>
          </view>
        </view>
        <text wx:if="{{item.target}}" class="text-xs disc__target">回复 {{item.target}}</text>
        <text wx:if="{{item.text}}" class="disc__text">{{item.text}}</text>
        <view wx:if="{{item.images.length}}" class="disc__images">
          <image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" class="disc__image" src="{{photo}}" mode="aspectFill" data-src="{{photo}}" bindtap="previewImage" />
        </view>
        <view class="disc__actions">
          <view class="disc__action" data-id="{{item.id}}" data-liked="{{item.likedByMe}}" bindtap="toggleLike">
            <image class="disc__action-icon" src="{{uiBase}}/like.svg" mode="aspectFit" />
            <text>{{item.likeCount || 0}}</text>
          </view>
          <view class="disc__action" data-id="{{item.id}}" data-name="{{item.author.name}}" bindtap="startReply">回复</view>
          <view wx:if="{{item.replyCount}}" class="disc__action" data-id="{{item.id}}" bindtap="toggleReplies">
            {{expanded === item.id ? '收起' : '展开 ' + item.replyCount + ' 条回复'}}
          </view>
        </view>
        <view wx:if="{{expanded === item.id}}" class="disc__replies">
          <view wx:for="{{replies}}" wx:for-item="reply" wx:key="id" class="disc__reply">
            <text class="disc__name">{{reply.author.name}}</text>
            <text wx:if="{{reply.target}}" class="text-xs disc__target">回复 {{reply.target}}</text>
            <text class="disc__text">{{reply.text}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!comments.length}}" class="empty">
        <image class="empty__icon" src="{{uiBase}}/comment.svg" mode="aspectFit" />
        <text>还没有人讨论这套卷</text>
      </view>
    </view>

    <view class="footer-bar">
      <view wx:if="{{replyTarget}}" class="disc__reply-bar">
        <text class="text-xs grow ellipsis">回复 {{replyTarget.name}}</text>
        <text class="text-xs" bindtap="cancelReply">取消</text>
      </view>
      <view class="footer-bar__inner">
        <input class="disc__input" value="{{replyTarget ? replyDraft : draft}}" placeholder="{{replyTarget ? '写下回复…' : '说说这套卷…'}}" placeholder-class="text-sm" bindinput="{{replyTarget ? 'onReplyDraft' : 'onDraft'}}" confirm-type="send" bindconfirm="{{replyTarget ? 'sendReply' : 'send'}}" />
        <view class="btn disc__send" bindtap="{{replyTarget ? 'sendReply' : 'send'}}">
          <image class="btn__icon" src="{{uiBase}}/send.svg" mode="aspectFit" />
        </view>
      </view>
    </view>
  </block>
</view>
