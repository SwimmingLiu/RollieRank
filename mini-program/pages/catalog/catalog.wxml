<page-meta page-style="overflow: hidden;" />
<view class="screen">
  <rr-nav title="{{publisher}}套卷" />

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" refresher-background="#fcf8f1" bindrefresherrefresh="onRefresherRefresh">
  <view class="page-scroll__body">
  <view wx:if="{{loading}}" class="loading">正在读取套卷…</view>
  <view wx:elif="{{error}}" class="state-wrap">
    <view class="state-card">
      <view class="state-card__badge">
        <image class="state-card__icon" src="/assets/ui/warn-ochre.svg" mode="aspectFit" />
      </view>
      <text class="state-card__title">暂时无法连接</text>
      <text class="state-card__desc">{{error}}</text>
      <button class="state-card__btn" bindtap="retry" hover-class="press">
        <image class="state-card__btn-icon" src="/assets/ui/refresh-light.svg" mode="aspectFit" />
        <text>重新读取</text>
      </button>
    </view>
  </view>

  <block wx:elif="{{projects.length}}">
    <view class="cat__library">
      <view class="cat__selector">
        <button wx:if="{{projects.length > 1}}" class="cat__hero {{institution === '超格' ? 'cat__hero--orange' : ''}}" bindtap="openProjects" hover-class="press">
          <view class="cat__hero-row">
            <view class="cat__hero-copy grow">
              <text class="cat__hero-title ellipsis">{{projects[activeProject].title}}</text>
              <text wx:if="{{projects[activeProject].metaText}}" class="cat__hero-meta ellipsis">{{projects[activeProject].metaText}}</text>
            </view>
            <text wx:if="{{projects[activeProject].doneCount}}" class="cat__hero-stat num">{{projects[activeProject].doneCount}}/{{projects[activeProject].versions.length}}</text>
            <view class="cat__hero-chevron"><image src="{{uiBase}}/chevron-down.svg" mode="aspectFit" /></view>
          </view>
          <view wx:if="{{projects[activeProject].doneCount}}" class="cat__hero-bar"><view style="width: {{projects[activeProject].doneProgress}}%;"></view></view>
        </button>
        <view wx:else class="cat__hero {{institution === '超格' ? 'cat__hero--orange' : ''}}">
          <view class="cat__hero-row">
            <view class="cat__hero-copy grow">
              <text class="cat__hero-title ellipsis">{{projects[activeProject].title}}</text>
              <text wx:if="{{projects[activeProject].metaText}}" class="cat__hero-meta ellipsis">{{projects[activeProject].metaText}}</text>
            </view>
            <text wx:if="{{projects[activeProject].doneCount}}" class="cat__hero-stat num">{{projects[activeProject].doneCount}}/{{projects[activeProject].versions.length}}</text>
          </view>
          <view wx:if="{{projects[activeProject].doneCount}}" class="cat__hero-bar"><view style="width: {{projects[activeProject].doneProgress}}%;"></view></view>
        </view>
      </view>
      <view class="cat__grid">
        <button wx:for="{{projects[activeProject].versions}}" wx:key="id" class="cat__paper cat__paper--{{item.state}}" data-id="{{item.id}}" data-action="{{item.actionType}}" bindtap="openPaper" hover-class="press"
          aria-label="{{item.numberText}}{{item.unitText}}，{{item.submitted ? '查看成绩' : item.state === 'draft' ? '继续录答案' : '录答案'}}">
          <view class="cat__paper-main">
            <view class="cat__paper-top">
              <view class="cat__paper-title {{item.number ? 'cat__paper-title--number' : ''}} {{item.submitted || item.state === 'draft' ? 'cat__paper-stamp' : ''}}">
                <text class="cat__paper-no {{item.number ? 'display-num num' : 'cat__paper-no--name'}}">{{item.numberText}}</text>
                <text wx:if="{{item.unitText && !item.submitted && item.state !== 'draft'}}" class="cat__paper-unit">{{item.unitText}}</text>
                <image wx:if="{{item.submitted}}" class="cat__paper-badge" src="{{uiBase}}/check.svg" mode="aspectFit" />
              </view>
            </view>
            <view class="cat__paper-foot">
              <view wx:if="{{item.submitted}}" class="cat__paper-state grow">
                <text class="display-num cat__paper-score">{{item.bestScore}}</text><text class="cat__paper-unit">分</text>
              </view>
              <view wx:elif="{{item.draftAnswered}}" class="cat__paper-draft grow">
                <view class="cat__paper-state"><text class="num cat__paper-count">{{item.draftAnswered}}</text><text class="cat__paper-unit">/{{item.questionCount}}</text></view>
                <view class="cat__progress"><view style="width: {{item.progress}}%;"></view></view>
              </view>
              <view wx:else class="cat__paper-action">
                <image class="cat__paper-arrow" src="{{uiBase}}/arrow-right.svg" mode="aspectFit" />
              </view>
            </view>
          </view>
        </button>
      </view>
    </view>
  </block>
  </view>
  </scroll-view>

  <rr-tabbar active="home" />

  <rr-option-sheet wx:if="{{projectsOpen}}" items="{{projectOptions}}" selected="{{projects[activeProject].key}}" label="选择套卷" bindselect="switchProject" binddismiss="closeProjects" />
</view>
