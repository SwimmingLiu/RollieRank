.cat__hero { margin: 12rpx 28rpx 24rpx; padding: 32rpx; background: #f7d9c9; border-radius: 32rpx; }
.cat__logo { width: 56rpx; height: 56rpx; }
.cat__hero-title { font-size: 36rpx; font-weight: 700; margin-top: 8rpx; }
.cat__tabs { white-space: nowrap; padding: 4rpx 28rpx 20rpx; }
.cat__tab { margin-right: 14rpx; flex-shrink: 0; }
.cat__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 0 28rpx; }
.cat__paper { padding: 26rpx 24rpx 22rpx; }
.cat__paper-no { font-size: 30rpx; font-weight: 600; }
.cat__paper-score { font-size: 30rpx; color: #b98a3e; }
.cat__paper-foot { margin-top: 34rpx; }
.cat__paper-action { font-size: 26rpx; color: #79767d; }
.cat__paper-arrow { width: 30rpx; height: 30rpx; opacity: 0.5; }
