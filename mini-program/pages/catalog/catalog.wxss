.cat__library { padding: 0 20px 20px; }
.cat__selector { padding: 8px 0 14px; }
.cat__hero { display: flex; flex-direction: column; gap: 10px; width: 100% !important; text-align: left; padding: 14px 16px; border: 1px solid #e6d5b2; border-radius: 20px; background: #f4e3be; box-shadow: 0 3px 0 #e6d4b0; color: #2f261d; }
.cat__hero--orange { background: #f9d2b8; border-color: #ecc0a3; box-shadow: 0 3px 0 #e7bca0; }
.cat__hero-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; }
.cat__hero-copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.cat__hero-title { font-size: 18px; line-height: 1.28; letter-spacing: -.35px; font-weight: 700; color: #2f261d; }
.cat__hero-meta { font-size: 12px; line-height: 1.3; color: #7e694d; font-weight: 500; }
.cat__hero-stat { flex: none; padding: 3px 8px; border-radius: 999px; background: rgba(255, 253, 248, .62); color: #5f4c32; font-size: 12px; font-weight: 700; }
.cat__hero-chevron { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 253, 248, .5); }
.cat__hero-chevron image { width: 16px; height: 16px; opacity: .72; }
.cat__hero-bar { width: 100%; height: 4px; border-radius: 99px; background: rgba(126, 105, 77, .16); overflow: hidden; }
.cat__hero-bar view { height: 100%; border-radius: 99px; background: #8c6e43; }
.cat__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
.cat__paper { position: relative; display: flex; align-items: center; width: 100% !important; min-height: 66px; padding: 12px 13px; background: #fffdf8; border: 1px solid #e8dfd0; border-radius: 17px; box-shadow: 0 3px 0 #ebe1d0; text-align: left; }
.cat__paper--complete { background: #f3e6cb; border-color: #e3d2b0; box-shadow: 0 3px 0 #e4d4b4; }
.cat__paper--draft { background: #fff1e3; border-color: #efd4b9; box-shadow: 0 3px 0 #eed4ba; }
.cat__paper-main { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; min-width: 0; }
.cat__paper-top { display: flex; align-items: center; flex: none; min-width: 0; }
.cat__paper-title { min-width: 0; max-width: 100%; display: flex; align-items: baseline; }
.cat__paper-title--number { white-space: nowrap; }
.cat__paper-stamp { position: relative; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: #e7d5b1; }
.cat__paper--draft .cat__paper-stamp { background: #f7dbc0; }
.cat__paper-no { font-size: 26px; line-height: 1; font-weight: 750; letter-spacing: -.7px; color: #2f261d; }
.cat__paper--complete .cat__paper-no, .cat__paper--draft .cat__paper-no { font-size: 17px; line-height: 1; font-weight: 750; letter-spacing: -.4px; color: #56442c; }
.cat__paper-no--name { font-size: 14px; line-height: 1.3; font-weight: 650; letter-spacing: 0; white-space: normal; overflow-wrap: anywhere; }
.cat__paper-unit { margin-left: 2px; color: #8c7b63; font-size: 11px; line-height: 1.3; white-space: nowrap; }
.cat__paper-badge { position: absolute; right: -4px; top: -4px; width: 15px; height: 15px; padding: 2px; border-radius: 50%; background: #fffdf8; border: 1px solid #d9c6a0; box-sizing: border-box; }
.cat__paper-foot { display: flex; align-items: center; justify-content: flex-end; flex: 1; min-width: 0; }
.cat__paper-state { display: flex; align-items: baseline; justify-content: flex-end; white-space: nowrap; min-width: 0; }
.cat__paper-score { font-size: 22px; line-height: 1; letter-spacing: -.6px; font-weight: 750; color: #2f261d; }
.cat__paper-draft { display: flex; flex-direction: column; gap: 5px; width: 100%; min-width: 0; }
.cat__paper-draft .cat__paper-state { justify-content: flex-start; }
.cat__paper-count { font-size: 17px; line-height: 1; letter-spacing: -.4px; font-weight: 750; color: #5f4a32; }
.cat__paper-action { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: #f4ece0; }
.cat__paper-arrow { width: 14px; height: 14px; flex: none; opacity: .72; }
.cat__progress { width: 100%; height: 4px; background: #eadcc9; border-radius: 99px; overflow: hidden; }
.cat__progress view { height: 100%; border-radius: 99px; background: #c5844a; }
@media (max-width: 350px) {
  .cat__library { padding-inline: 16px; }
  .cat__grid { gap: 9px; }
  .cat__paper { min-height: 60px; padding: 10px 10px; border-radius: 15px; }
  .cat__paper-main { gap: 7px; }
  .cat__paper-stamp { width: 34px; height: 34px; border-radius: 10px; }
  .cat__paper-no { font-size: 23px; }
  .cat__paper--complete .cat__paper-no, .cat__paper--draft .cat__paper-no { font-size: 15px; }
  .cat__paper-score { font-size: 19px; }
  .cat__paper-count { font-size: 15px; }
  .cat__paper-action { width: 25px; height: 25px; }
  .cat__paper-arrow { width: 12px; height: 12px; }
  .cat__paper-no--name { font-size: 13px; }
}
