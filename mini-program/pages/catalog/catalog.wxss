.cat__hero { margin: 10px 22px 16px; padding: 20px 22px; background: #f9d9c0; border-radius: 16px; display: flex; flex-direction: column; gap: 6px; }
.cat__hero-meta { font-size: 12px; color: #8a6a4f; }
.cat__hero-title { font-size: 20px; font-weight: 700; color: #18181b; letter-spacing: 0.3px; }
.cat__tabs { white-space: nowrap; padding: 0 22px 12px; }
.cat__tab { margin-right: 8px; flex-shrink: 0; }
.cat__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 0 22px; }
.cat__paper { position: relative; padding: 16px 14px; min-height: 78px; display: flex; flex-direction: column; justify-content: space-between; }
.cat__paper-no { font-size: 13px; color: #71717a; }
.cat__paper-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; }
.cat__paper-action { font-size: 16px; color: #18181b; }
.cat__paper-arrow { width: 16px; height: 16px; opacity: 0.45; }
.cat__paper-score { position: absolute; right: 14px; top: 14px; font-size: 13px; color: #a16207; font-variant-numeric: tabular-nums; }
