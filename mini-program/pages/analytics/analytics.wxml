<view class="screen">
  <rr-nav title="成长分析" />

  <view wx:if="{{loading}}" class="loading">正在汇总记录…</view>
  <view wx:elif="{{!hasData}}" class="empty">
    <image class="empty__icon" src="{{uiBase}}/trend.svg" mode="aspectFit" />
    <text>完成一次正式练习后，这里会出现趋势</text>
  </view>

  <block wx:else>
    <view class="card analytics__hero">
      <view class="row row--between">
        <view class="stack">
          <text class="text-xs">累计平均得分率</text>
          <text class="num analytics__average">{{averageText}}</text>
        </view>
        <text class="chip {{trendUp === false ? 'chip--coral' : ''}}">{{trendText}}</text>
      </view>
      <text class="text-xs analytics__note">{{points.length}} 次正式练习，按每份记录自己的得分与满分计算</text>
    </view>

    <view class="card analytics__chart">
      <text class="analytics__title">得分率走势</text>
      <view class="analytics__bars">
        <view wx:for="{{points}}" wx:key="id" class="analytics__bar-col" data-id="{{item.id}}" bindtap="openRecord">
          <text class="text-xs">{{item.pct}}%</text>
          <view class="analytics__bar" style="height: {{item.pct * 2 + 6}}rpx;"></view>
          <text class="analytics__bar-date">{{item.dateText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{subjects.length}}" class="card analytics__subjects">
      <text class="analytics__title">题型累计</text>
      <view wx:for="{{subjects}}" wx:key="name" class="analytics__subject">
        <view class="row row--between">
          <text class="text-md">{{item.name}}</text>
          <text class="num text-sm">{{item.pct}}%</text>
        </view>
        <view class="progress analytics__progress">
          <view class="progress__fill" style="width: {{item.pct}}%;"></view>
        </view>
      </view>
    </view>
  </block>
</view>
