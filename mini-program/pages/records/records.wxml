<view class="screen screen--tab" style="padding-top: {{safeTop}}px;">
  <!-- 标题居中，右侧设置入口放在胶囊下方，不与系统按钮重叠。 -->
  <view class="records__head">
    <text class="records__title">练习记录</text>
    <view class="records__settings" bindtap="openSettings">
      <image class="records__settings-icon" src="{{uiBase}}/help.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="records__profile">
    <image class="records__avatar" src="{{asset.profile}}" mode="aspectFit" />
    <view class="stack grow">
      <text class="records__name" bindtap="openSettings">{{name}}</text>
      <text class="text-xs">{{totals.count}} 份练习</text>
    </view>
  </view>

  <view class="records__grid">
    <view class="card press records__cell" bindtap="openPosition">
      <view class="records__cell-head">
        <image class="records__cell-lead" src="{{uiBase}}/map-pin.svg" mode="aspectFit" />
        <text class="text-xs">报考岗位</text>
      </view>
      <text class="records__cell-value ellipsis">{{position ? position.label : '未选岗'}}</text>
      <image class="records__cell-icon" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
    </view>
    <view class="card press records__cell" bindtap="openAnalytics">
      <view class="records__cell-head">
        <image class="records__cell-lead" src="{{uiBase}}/trend.svg" mode="aspectFit" />
        <text class="text-xs">成长分析</text>
      </view>
      <text class="records__cell-value">{{records.length > 1 ? '查看进步' : '累计记录'}}</text>
      <image class="records__cell-icon" src="{{uiBase}}/chevron.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="records__tabs">
    <view class="tabs grow">
      <view wx:for="{{tabs}}" wx:key="key" class="tabs__item {{tab === item.key ? 'tabs__item--on' : ''}}" data-key="{{item.key}}" bindtap="setTab">{{item.label}}</view>
    </view>
    <view class="records__search" bindtap="toggleSearch">
      <image class="records__search-icon" src="{{uiBase}}/{{searching ? 'close' : 'search'}}.svg" mode="aspectFit" />
    </view>
  </view>
  <view wx:if="{{searching}}" class="records__search-bar card">
    <input value="{{keyword}}" placeholder="搜索套卷或机构" placeholder-class="text-xs" bindinput="onKeyword" focus="{{searching}}" />
  </view>

  <view class="records__list">
    <view wx:for="{{visible}}" wx:key="id" class="card press records__row" data-id="{{item.id}}" bindtap="openRecord">
      <view class="row row--between">
        <text class="text-xs ellipsis grow">{{item.detail}}</text>
        <text class="text-xs">{{item.dateText}}</text>
      </view>
      <view class="row row--between records__row-main">
        <text class="records__row-title ellipsis grow">{{item.title}}</text>
        <text class="num records__row-score">{{item.scoreText}}</text>
      </view>
      <view class="row row--between records__row-meta">
        <text class="text-xs">得分率 {{item.rateText}} · 正确 {{item.correct}} · 错误 {{item.wrong}}</text>
        <text class="text-xs">看成绩</text>
      </view>
    </view>

    <view wx:if="{{!visible.length && !records.length}}" class="empty">
      <image class="empty__icon" src="{{uiBase}}/book.svg" mode="aspectFit" />
      <text>还没有练习记录</text>
      <view class="chip" bindtap="openHome">去选卷</view>
    </view>
    <view wx:elif="{{!visible.length}}" class="empty">
      <text>没有符合条件的记录</text>
    </view>
  </view>

  <rr-tabbar active="records" />
</view>
