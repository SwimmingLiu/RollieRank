.records__head { position: relative; display: flex; align-items: center; justify-content: center; height: 44px; }
.records__title { font-size: 17px; font-weight: 600; }
.records__settings { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
.records__settings-icon { width: 20px; height: 20px; opacity: 0.55; }
.records__profile { margin: 4px 22px 12px; padding: 16px; display: flex; align-items: center; gap: 12px; background: #f4e3be; border-radius: 16px; }
.records__avatar { width: 50px; height: 50px; border-radius: 50%; background: #fffdf8; border: 2px solid #fffdf8; }
.records__name { font-size: 20px; font-weight: 700; }
.records__totals { text-align: right; }
.records__total-num { display: block; font-size: 20px; font-weight: 700; }
.records__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 0 22px; }
.records__cell { position: relative; padding: 14px; }
.records__cell-head { display: flex; align-items: center; gap: 5px; }
.records__cell-lead { width: 14px; height: 14px; opacity: 0.6; }
.records__cell-value { display: block; margin-top: 8px; font-size: 16px; font-weight: 600; padding-right: 20px; }
.records__cell-icon { position: absolute; right: 14px; bottom: 18px; width: 14px; height: 14px; opacity: 0.45; }
.records__tabs { display: flex; align-items: center; gap: 8px; padding: 14px 22px 0; }
.records__search { width: 42px; height: 40px; border-radius: 14px; background: #ffffff; border: 1px solid #e4e4e7; display: flex; align-items: center; justify-content: center; }
.records__search-icon { width: 18px; height: 18px; opacity: 0.6; }
.records__search-bar { margin: 8px 14px 0; padding: 0 13px; height: 42px; display: flex; align-items: center; }
.records__list { padding: 12px 22px 30px; display: flex; flex-direction: column; gap: 8px; }
.records__row { padding: 14px; }
.records__row-main { margin-top: 7px; }
.records__row-title { font-size: 15px; font-weight: 600; }
.records__row-score { font-size: 20px; font-weight: 700; margin-left: 10px; }
.records__row-meta { margin-top: 8px; padding-top: 8px; border-top: 1px solid #f1ebe0; }
