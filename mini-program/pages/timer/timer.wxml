<view class="screen">
  <rr-nav title="做题计时" />
  <view wx:if="{{loading}}" class="loading">正在准备计时…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="chip" bindtap="load">重新读取</button></view>

  <view wx:else class="timer">
    <view wx:if="{{running}}" class="timer__clock">
      <text class="display-num timer__time">{{elapsed}}</text>
      <text class="timer__muted">{{paused ? '已暂停' : '计时中'}}</text>
    </view>
    <block wx:else>
      <view class="timer__switch">
        <button class="timer__switch-item {{source === 'paper' ? 'timer__switch-item--on' : ''}}" data-source="paper" bindtap="setSource">套卷</button>
        <button class="timer__switch-item {{source === 'custom' ? 'timer__switch-item--on' : ''}}" data-source="custom" bindtap="setSource">自定义</button>
      </view>
      <button wx:if="{{source === 'paper'}}" class="timer__paper" bindtap="choosePaper">
        <view class="stack grow">
          <text class="timer__label">{{selected ? selected.title : '选择套卷'}}</text>
          <text wx:if="{{selected}}" class="timer__muted">{{selected.questionCount}} 题 · {{selected.defaultMinutes}} 分钟</text>
        </view>
        <image src="{{uiBase}}/chevron.svg" mode="aspectFit" />
      </button>
      <view class="timer__plan">
        <text class="timer__label">计时计划</text>
        <view class="timer__stepper">
          <button class="timer__step" data-delta="-1" bindtap="stepWhole" aria-label="减少一分钟">−</button>
          <view class="timer__value">
            <input class="num timer__input" type="number" value="{{wholeMinutes}}" bindinput="onWholeInput" bindblur="save" />
            <text class="timer__muted">分钟</text>
          </view>
          <button class="timer__step" data-delta="1" bindtap="stepWhole" aria-label="增加一分钟">+</button>
        </view>
        <view wx:if="{{selected && source === 'paper'}}" class="timer__switch">
          <button class="timer__switch-item {{mode === 'whole' ? 'timer__switch-item--on' : ''}}" data-mode="whole" bindtap="setMode">整卷</button>
          <button class="timer__switch-item {{mode === 'modules' ? 'timer__switch-item--on' : ''}}" data-mode="modules" bindtap="setMode">模块计划</button>
        </view>
        <view wx:if="{{mode === 'modules'}}" class="timer__modules">
          <view wx:for="{{sections}}" wx:key="key" class="timer__module">
            <text class="grow">{{item.type}}</text>
            <button class="timer__step" data-index="{{index}}" data-delta="-1" bindtap="stepModule">−</button>
            <text class="timer__module-min">{{item.minutes}} 分钟</text>
            <button class="timer__step" data-index="{{index}}" data-delta="1" bindtap="stepModule">+</button>
          </view>
          <view class="row row--between timer__total"><text>模块合计</text><text>{{planTotal}} 分钟</text></view>
        </view>
      </view>
    </block>
    <view class="footer-bar">
      <view class="footer-bar__inner">
        <button wx:if="{{running}}" class="btn btn--ghost timer__pause" bindtap="pause">{{paused ? '继续' : '暂停'}}</button>
        <button wx:if="{{running}}" class="btn btn--primary" bindtap="finish">结束并录答案</button>
        <button wx:else class="btn btn--primary" bindtap="start"><image class="btn__icon" src="{{uiBase}}/play-light.svg" mode="aspectFit" />开始计时</button>
      </view>
    </view>
  </view>

  <view wx:if="{{paperPicker}}" class="sheet-layer">
    <view class="sheet-shade" catchtap="closePaperPicker"></view>
    <view class="sheet-panel">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <button class="sheet-close" wx:if="{{activeProject >= 0}}" bindtap="closePaperPicker" aria-label="返回机构"><image src="{{uiBase}}/back.svg" mode="aspectFit" /></button>
        <text class="grow">{{activeProject >= 0 ? papers[activeProject].label : '选择套卷'}}</text>
        <button class="sheet-close" bindtap="closePaperPicker" aria-label="关闭"><image src="{{uiBase}}/close.svg" mode="aspectFit" /></button>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <block wx:if="{{activeProject < 0}}">
          <button wx:for="{{papers}}" wx:key="name" class="timer__picker-row" data-index="{{index}}" bindtap="openSection">
            <text class="grow">{{item.label}}</text><image src="{{uiBase}}/chevron.svg" mode="aspectFit" />
          </button>
        </block>
        <block wx:else>
          <button wx:for="{{papers[activeProject].versions}}" wx:key="id" class="timer__picker-row" data-id="{{item.id}}" bindtap="pickPaper">
            <view class="stack grow"><text>{{item.title}}</text><text class="timer__muted">{{item.questionCount}} 题 · {{item.defaultMinutes}} 分钟</text></view>
            <image src="{{uiBase}}/chevron.svg" mode="aspectFit" />
          </button>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
