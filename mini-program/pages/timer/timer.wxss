.timer { display: flex; flex-direction: column; gap: 12px; padding: 14px 20px 22px; }
.timer__switch { display: flex; gap: 4px; padding: 4px; border-radius: 14px; background: #ebe4d9; }
.timer__switch-item { display: flex; align-items: center; justify-content: center; flex: 1; width: 0 !important; min-height: 42px; font-size: 14px; border-radius: 10px; color: #786955; }
.timer__switch-item--on { background: #fffdf8; color: #34291e; font-weight: 650; }
.timer__paper, .timer__plan, .timer__clock { min-height: 76px; border-radius: 20px; padding: 14px 16px; background: #fffdf8; border: 1px solid #e6ddce; }
.timer__paper { display: flex; align-items: center; width: 100% !important; text-align: left; gap: 9px; }
.timer__paper image, .timer__picker-row image { width: 16px; height: 16px; flex: none; opacity: .65; }
.timer__label { font-size: 16px; font-weight: 650; color: #4c4134; }
.timer__muted { font-size: 12px; color: #978164; }
.timer__stepper { display: flex; align-items: center; gap: 12px; justify-content: space-between; padding: 11px 0 14px; }
.timer__step { display: grid; place-items: center; width: 42px !important; min-height: 42px; border: 1px solid #e9dfce; border-radius: 12px; background: #f5ecdb; color: #776045; font-size: 21px; flex: none; }
.timer__value { display: flex; align-items: center; gap: 5px; }
.timer__input { width: 76px; height: 44px; min-height: 44px; line-height: 44px; padding: 0 4px; background: #fcf8f1; border: 1px solid #e9dfce; border-radius: 10px; font-size: 22px; text-align: center; }
.timer__modules { padding-top: 7px; }
.timer__module, .timer__total { display: flex; align-items: center; gap: 8px; min-height: 50px; border-bottom: 1px solid #eee5d6; color: #665643; font-size: 13px; }
.timer__module .timer__step { width: 33px !important; min-height: 33px; }
.timer__module-min { min-width: 49px; text-align: center; font-variant-numeric: tabular-nums; white-space: nowrap; }
.timer__total { border: 0; }
.timer__clock { min-height: 165px; display: grid; align-content: center; justify-items: center; background: #f4e3be; }
.timer__time { font-size: min(14vw, 64px); line-height: 1.13; font-weight: 750; }
.timer__pause { width: 88px !important; }
.timer__picker-row { display: flex; width: 100% !important; gap: 10px; align-items: center; min-height: 54px; padding: 7px 10px; text-align: left; border-bottom: 1px solid #ebe2d3; border-radius: 0; font-size: 14px; }
@media (max-width: 350px) { .timer { padding-inline: 16px; } }
