<page-meta page-style="overflow: hidden;" />
<view class="screen">
  <rr-nav title="{{filter === 'marked' ? '待检查' : filter === 'wrong' ? '错题复盘' : '逐题对照'}}" action-icon="{{canFeedback ? 'comment' : ''}}" action-label="反馈参考答案" bind:action="openFeedback" />
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-scroll__body">
  <view wx:if="{{loading}}" class="loading">正在读取答卷…</view>
  <view wx:elif="{{error}}" class="state-wrap">
    <view class="state-card">
      <view class="state-card__badge">
        <image class="state-card__icon" src="/assets/ui/warn-ochre.svg" mode="aspectFit" />
      </view>
      <text class="state-card__title">暂时无法连接</text>
      <text class="state-card__desc">{{error}}</text>
      <button class="state-card__btn" bindtap="load" hover-class="press">
        <image class="state-card__btn-icon" src="/assets/ui/refresh-light.svg" mode="aspectFit" />
        <text>重新读取</text>
      </button>
    </view>
  </view>

  <view wx:else class="review">
    <view class="review__scope-row">
      <button class="review__scope" bindtap="openTypes"><text>{{typeLabel}}</text><image src="{{uiBase}}/chevron-down.svg" mode="aspectFit" /></button>
    </view>
    <view class="review__tabs">
      <button wx:for="{{filters}}" wx:key="key" class="review__tab {{filter === item.key ? 'review__tab--on' : ''}}" data-key="{{item.key}}" bindtap="setFilter">{{item.label}} {{counts[item.key]}}</button>
    </view>
    <view class="review__table">
      <view class="review__columns review__labels"><text>题号</text><text>我的</text><text>参考</text><text>结果</text><text>答对率</text></view>
      <view wx:for="{{groups}}" wx:key="type" class="review__group">
        <view class="review__group-label">{{item.type}}</view>
        <view wx:for="{{item.rows}}" wx:for-item="question" wx:key="n" class="review__columns review__row">
          <text class="review__number">{{question.numberText}}</text>
          <text class="review__answer review__answer--{{question.status}}">{{question.answer}}</text>
          <text class="review__reference">{{question.ref}}</text>
          <image class="review__result" src="{{uiBase}}/{{question.status === 'correct' ? 'result-ok' : question.status === 'wrong' ? 'result-wrong' : 'dot'}}.svg" mode="aspectFit" aria-label="{{question.statusLabel}}" />
          <view class="review__cohort">
            <text>{{question.correctRate || '—'}}</text>
            <text wx:if="{{question.sameWrongRate}}" class="review__same-wrong">同错 {{question.sameWrongRate}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!groups.length}}" class="empty">当前筛选没有题目</view>
    </view>
  </view>
  </view>
  </scroll-view>
  <view wx:if="{{!loading && !error}}" class="footer-bar"><button class="btn btn--primary review__copy" bindtap="copyWrong" disabled="{{!copyCount}}" aria-label="复制错题号"><image class="btn__icon" src="{{uiBase}}/copy.svg" mode="aspectFit" /><text>{{copyCount ? '复制错题号 (' + copyCount + ')' : '暂无错题'}}</text></button></view>
  <rr-option-sheet wx:if="{{typesOpen}}" items="{{types}}" selected="{{activeType}}" label="选择板块" bindselect="setType" binddismiss="closeTypes" />
  <view wx:if="{{feedbackOpen && !historyOpen}}" class="sheet-layer {{sheetDragging ? 'sheet-layer--dragging' : ''}} {{sheetClosing ? 'sheet-layer--closing' : ''}}">
    <view class="sheet-shade" style="{{sheetShadeOpacity < 1 ? 'opacity: ' + sheetShadeOpacity + ';' : ''}}" catchtap="closeFeedback" catchtouchmove="noopSheet"></view>
    <view class="sheet-panel review__feedback-sheet" style="{{sheetDragY ? 'transform: translateY(' + sheetDragY + 'px);' : ''}}" aria-role="dialog" aria-label="反馈参考答案"
      bindtouchstart="startSheetDrag" bindtouchmove="moveSheetDrag" bindtouchend="endSheetDrag" bindtouchcancel="cancelSheetDrag">
      <view class="sheet-grabber-zone" data-sheet-zone="handle" catchtouchstart="startSheetDrag" catchtouchmove="moveSheetDrag" catchtouchend="endSheetDrag" catchtouchcancel="cancelSheetDrag">
        <view class="sheet-grabber"></view>
      </view>
      <view class="sheet-head"><text>{{feedbackPicking ? '选择反馈题目' : '反馈参考答案'}}</text><button class="icon-button review__history-link" bindtap="openFeedbackHistory" aria-label="反馈记录"><image src="{{uiBase}}/records.svg" mode="aspectFit" /></button></view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="review__feedback-scroll" bindscroll="onSheetScroll">
        <view wx:if="{{feedbackPicking}}" class="review__question-picker">
          <button wx:for="{{feedbackQuestions}}" wx:key="n" class="review__question-choice {{item.marked ? 'review__question-choice--marked' : ''}}" data-number="{{item.n}}" disabled="{{item.selected}}" bindtap="pickFeedbackQuestion" aria-label="反馈第 {{item.n}} 题">{{item.n}}</button>
        </view>
        <block wx:else>
          <view wx:for="{{feedbackItems}}" wx:for-item="feedback" wx:for-index="feedbackIndex" wx:key="question" class="review__feedback-card">
            <view class="row row--between review__feedback-card-head">
              <text>第 {{feedback.question}} 题</text>
              <button wx:if="{{feedbackItems.length > 1}}" class="icon-button" data-index="{{feedbackIndex}}" bindtap="removeFeedbackQuestion" aria-label="移除第 {{feedback.question}} 题"><image src="{{uiBase}}/close.svg" mode="aspectFit" /></button>
            </view>
            <text class="review__reference-line">我选 {{feedback.answer}} · 参考 {{feedback.reference}}</text>
            <view class="review__field"><text>建议答案</text><view class="review__answer-options"><button wx:for="{{feedbackChoices}}" wx:key="*this" class="review__answer-option {{feedback.suggestedAnswer === item ? 'review__answer-option--on' : ''}}" data-index="{{feedbackIndex}}" data-answer="{{item}}" bindtap="chooseSuggestion" aria-pressed="{{feedback.suggestedAnswer === item}}" disabled="{{submittingFeedback}}">{{item}}</button></view></view>
            <label class="review__field">反馈依据<textarea data-sheet-no-drag="1" value="{{feedback.evidence}}" maxlength="4000" placeholder="填写题本页码、解析出处或核对依据" data-index="{{feedbackIndex}}" bindinput="onFeedbackEvidence" disabled="{{submittingFeedback}}" /></label>
          </view>
          <button class="review__add-feedback review__add-question" bindtap="addFeedbackQuestion" aria-label="再反馈一题">＋ 再反馈一题</button>
        </block>
      </scroll-view>
      <text wx:if="{{feedbackError}}" class="review__feedback-error" aria-role="alert">{{feedbackError}}</text>
      <view wx:if="{{feedbackPicking}}" class="review__feedback-actions"><button bindtap="backFeedback">{{feedbackItems.length ? '返回反馈' : '取消'}}</button></view>
      <view wx:else class="review__feedback-actions"><button bindtap="closeFeedback" disabled="{{submittingFeedback}}">取消</button><button bindtap="submitFeedback" loading="{{submittingFeedback}}" disabled="{{submittingFeedback}}">提交反馈</button></view>
    </view>
  </view>
  <view wx:if="{{historyOpen}}" class="sheet-layer {{sheetDragging ? 'sheet-layer--dragging' : ''}} {{sheetClosing ? 'sheet-layer--closing' : ''}}">
    <view class="sheet-shade" style="{{sheetShadeOpacity < 1 ? 'opacity: ' + sheetShadeOpacity + ';' : ''}}" catchtap="closeFeedbackHistory" catchtouchmove="noopSheet"></view>
    <view class="sheet-panel review__feedback-sheet" style="{{sheetDragY ? 'transform: translateY(' + sheetDragY + 'px);' : ''}}" aria-role="dialog" aria-label="反馈记录"
      bindtouchstart="startSheetDrag" bindtouchmove="moveSheetDrag" bindtouchend="endSheetDrag" bindtouchcancel="cancelSheetDrag">
      <view class="sheet-grabber-zone" data-sheet-zone="handle" catchtouchstart="startSheetDrag" catchtouchmove="moveSheetDrag" catchtouchend="endSheetDrag" catchtouchcancel="cancelSheetDrag">
        <view class="sheet-grabber"></view>
      </view>
      <view class="sheet-head"><text>{{feedbackDetail ? '反馈处理详情' : '反馈记录'}}</text><button class="sheet-close" data-sheet-no-drag="1" catchtap="closeFeedbackHistory" aria-label="关闭"><image data-sheet-no-drag="1" src="{{uiBase}}/close.svg" mode="aspectFit" /></button></view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="review__feedback-scroll" bindscroll="onSheetScroll">
        <block wx:if="{{feedbackDetail}}">
          <view wx:for="{{feedbackDetail.items}}" wx:key="question" class="review__feedback-card">
            <view class="row row--between review__feedback-card-head"><text>第 {{item.question}} 题</text><text class="review__feedback-status">{{item.statusLabel}}</text></view>
            <text class="review__reference-line">参考 {{item.originalAnswer}} → 建议 {{item.suggestedAnswer}}</text>
            <text class="review__feedback-evidence">{{item.evidence}}</text>
            <text wx:if="{{item.reason}}" class="review__feedback-evidence">审核理由 · {{item.reason}}</text>
          </view>
          <view wx:if="{{feedbackPreview}}" class="review__preview">
            <view><text>当前成绩</text><text>{{feedbackPreview.official}} 分</text></view>
            <view><text>试算成绩</text><text>{{feedbackPreview.projected}} 分</text></view>
            <view><text>分数变化</text><text>{{feedbackPreview.delta}} 分</text></view>
          </view>
          <button wx:elif="{{feedbackDetail.canPreview}}" class="review__add-feedback" bindtap="previewFeedback" loading="{{historyLoading}}">试算影响</button>
        </block>
        <block wx:else>
          <button wx:for="{{feedbackHistory}}" wx:key="id" class="review__history-row" data-id="{{item.id}}" bindtap="openFeedbackDetail">
            <text class="grow">{{item.items.length}} 道题</text><text>{{item.statusLabel}}</text><image src="{{uiBase}}/chevron.svg" mode="aspectFit" />
          </button>
          <view wx:if="{{!feedbackHistory.length && !historyError}}" class="review__history-empty">{{historyLoading ? '正在读取…' : '这份答卷暂无反馈'}}</view>
        </block>
      </scroll-view>
      <text wx:if="{{historyError}}" class="review__feedback-error" aria-role="alert">{{historyError}}</text>
      <view class="review__feedback-actions">
        <button wx:if="{{feedbackDetail}}" bindtap="backToFeedbackList">返回记录</button>
        <button wx:else bindtap="openAdmin">维护者审核</button>
        <button bindtap="closeFeedbackHistory">关闭</button>
      </view>
    </view>
  </view>
  <rr-toast id="rr-toast" bottom="{{92}}" />
</view>
